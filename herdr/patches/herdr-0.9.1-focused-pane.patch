+    /// Switch this client to the next (or previous) online machine in catalog
+    /// order, wrapping around. Offline machines are skipped; with no other
+    /// online machine the client stays put and says so.
+    pub(super) fn cycle_machine(&mut self, forward: bool, outcome: &mut ClientShellInput) {
+        let count = self.endpoints.len();
+        let current = self
+            .endpoints
+            .iter()
+            .position(|endpoint| endpoint.endpoint_id == self.active_endpoint_id)
+            .unwrap_or(0);
+        let candidate = (1..count)
+            .map(|step| {
+                if forward {
+                    (current + step) % count
+                } else {
+                    (current + count - step) % count
+                }
+            })
+            .map(|index| self.endpoints[index].endpoint_id.clone())
+            .find(|endpoint_id| self.endpoint_is_online(endpoint_id));
+        let Some(endpoint_id) = candidate else {
+            let message = if count > 1 {
+                let others = self
+                    .endpoints
+                    .iter()
+                    .filter(|endpoint| endpoint.endpoint_id != self.active_endpoint_id)
+                    .map(|endpoint| endpoint.label.as_str())
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                format!("{others} is not ready")
+            } else {
+                "no other machine is saved".to_owned()
+            };
+            self.receive_endpoint_unavailable(message);
+            outcome.repaint = true;
+            return;
+        };
+        self.activate_endpoint(endpoint_id, outcome);
+    }

+fn worktree_move_keeps_neighbours_and_hidden_spaces_in_place() {
+    // other; repo [main, beta, alpha] (+ a hidden checkout); mid; last.
+    let mut snapshot = snapshot();
+    let labels = ["other", "repo", "mid", "repo", "repo", "repo", "last"];
+    snapshot.workspaces = labels
+        .iter()
+        .enumerate()
+        .map(|(index, label)| workspace(index + 1, label, index == 0))
+        .collect();
+    linked(&mut snapshot, 2, "worktree/beta", true);
+    linked(&mut snapshot, 4, "main", false);
+    linked(&mut snapshot, 5, "worktree/hidden", true);
+    linked(&mut snapshot, 6, "worktree/alpha", true);
+    snapshot.workspaces[4]
+        .tokens
+        .push((SIDEBAR_HIDDEN_TOKEN.into(), "work".into()));
+    let method = |snapshot: &ClientShellSnapshot, id, before| {
+        crate::client::shell::tree::worktree_move_method(snapshot, None, id, before)
+    };
+    assert!(
+        method(&snapshot, "ws_2", Some("ws_6")).is_none(),
+        "already there"
+    );
+    assert!(
+        method(&snapshot, "ws_6", Some("ws_3")).is_none(),
+        "outside the group"
+    );
+    assert!(
+        method(&snapshot, "ws_6", Some("ws_5")).is_none(),
+        "hidden sibling"
+    );
+    assert!(method(&snapshot, "ws_4", None).is_none(), "main checkout");
+
+    let Some(crate::api::schema::Method::WorkspaceMoveBlock(params)) =
+        method(&snapshot, "ws_6", Some("ws_2"))
+    else {
+        panic!("alpha moves above beta");
+    };
+    assert_eq!(params.workspace_ids, ids(&["ws_4", "ws_6", "ws_2"]));
+    assert_eq!(params.before_workspace_id.as_deref(), Some("ws_3"));
+    apply_block(
+        &mut snapshot,
+        &params.workspace_ids,
+        params.before_workspace_id.as_deref(),
+    );
+    assert_eq!(
+        snapshot
+            .workspaces
+            .iter()
+            .map(|workspace| workspace.workspace_id.as_str())
+            .collect::<Vec<_>>(),
+        ["ws_1", "ws_4", "ws_6", "ws_2", "ws_3", "ws_5", "ws_7"],
+        "the hidden checkout keeps its place among unmoved Spaces"
+    );
+    let mut state = tree_state(snapshot);
+    let rows = tall_rows(&mut state)
+        .into_iter()
+        .filter(|row| !row.trim_matches(['│', ' ']).is_empty())
+        .collect::<Vec<_>>();
+    let tree = rows
+        .iter()
+        .skip(1)
+        .take(7)
+        .map(|row| row.split("  ").next().unwrap_or("").trim_end())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        tree,
+        [
+            " other",
+            " repo",
+            " ├─ main",
+            " ├─ alpha",
+            " └─ beta",
+            " mid",
+            " last"
+        ],
+        "{rows:?}"
+    );
+}

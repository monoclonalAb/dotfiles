+        assert_eq!(
+            symbol_fg(&frame, row, symbol),
+            Some(crate::protocol::color_to_u32(color)),
+            "{value}"
+        );
+    }
+}
+
+#[test]
+fn long_pull_request_title_truncates_before_the_glyph_or_counts() {
+    use crate::client::shell::tree::{PR_NUMBER_TOKEN, PR_STATE_TOKEN, PR_TITLE_TOKEN};
+    let mut snapshot = worktree_fixture(1);
+    // gamma has one conversation, so its row carries a count suffix.
+    report_pull_request(
+        &mut snapshot,
+        5,
+        &[
+            (PR_NUMBER_TOKEN, "1234"),
+            (
+                PR_TITLE_TOKEN,
+                "feat: match two-word owner names with spouse or exact-address proof",
+            ),
+            (PR_STATE_TOKEN, "draft"),
+        ],
+    );
+    let mut state = tree_state(snapshot);
+    let rows = tall_rows(&mut state);
+    assert!(
+        rows[11].starts_with(" └─ \u{f4dd} #1234 feat:"),
+        "{:?}",
+        rows[11]
+    );
+    assert!(rows[11].contains('…'), "{:?}", rows[11]);
+    assert!(rows[11].ends_with("○ 1"), "{:?}", rows[11]);
+    assert_eq!(rows[12], "    └─ ○ gamma task");
+}

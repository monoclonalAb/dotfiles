+    assert!(rows.iter().any(|row| row.contains("website")));
+
+    // An empty value means not hidden.
+    let mut update = state.snapshot.as_deref().unwrap().clone();
+    update.revision = 3;
+    update.focused_workspace_id = Some("ws_1".into());
+    for workspace in &mut update.workspaces {

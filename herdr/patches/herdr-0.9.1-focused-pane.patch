+fn tree_state(snapshot: ClientShellSnapshot) -> ClientShellState {
+    let mut state = ClientShellState::new(tree_config());
+    state.set_snapshot(Box::new(snapshot));
+    state.set_pane_surface(surface());
+    state
+}
+
+fn frame_rows(frame: &FrameData) -> Vec<String> {
+    frame
+        .cells
+        .chunks(frame.width as usize)
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+                .trim_end()
+                .to_owned()
+        })
+        .collect()
+}
+
+fn sidebar_rows(state: &mut ClientShellState) -> Vec<String> {
+    let frame = state.compose(106, 14).expect("composed frame");
+    // Drop the separator column and any scrollbar track / toggle glyph.
+    let width = usize::from(state.sidebar_width.saturating_sub(1));
+    frame_rows(&frame)
+        .into_iter()
+        .map(|row| {
+            row.chars()
+                .take(width)
+                .collect::<String>()
+                .trim_end_matches(['▕', '«', '»'])
+                .trim_end()
+                .to_owned()
+        })
+        .collect()
+}
+
+fn click(state: &mut ClientShellState, column: u16, row: u16) -> ClientShellInput {
+    let mut outcome =
+        state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column,
+            row,
+            modifiers: KeyModifiers::empty(),
+        })]);
+    let release =
+        state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+            kind: MouseEventKind::Up(MouseButton::Left),
+            column,
+            row,
+            modifiers: KeyModifiers::empty(),
+        })]);
+    outcome.actions.extend(release.actions);
+    outcome.repaint |= release.repaint;
+    outcome
+}
+
+fn focus_requests(outcome: &ClientShellInput) -> Vec<String> {
+    outcome
+        .actions
+        .iter()
+        .filter_map(|action| match action {
+            ClientShellAction::Endpoint { request, .. } => match &request.method {
+                crate::api::schema::Method::WorkspaceFocus(target) => {
+                    Some(format!("workspace:{}", target.workspace_id))
+                }
+                crate::api::schema::Method::PaneFocus(target) => {
+                    Some(format!("pane:{}", target.pane_id))
+                }
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect()
+}
+
+fn workspace_row(state: &ClientShellState, workspace_id: &str) -> Option<u16> {
+    state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.workspace_id == workspace_id && hit.group_toggle.is_none())
+        .map(|hit| hit.rect.y)
+}
+
+fn agent_row(state: &ClientShellState, pane_id: &str) -> Option<u16> {
+    state
+        .hits
+        .agents
+        .iter()
+        .find(|(_, id)| id == pane_id)
+        .map(|(rect, _)| rect.y)
+}

+//! Inline Spaces tree (`ui.sidebar.spaces.inline_agents`).
+//!
+//! One row document shared by rendering, scrolling, disclosure and hit-testing:
+//! repository → checkout/Space → conversation. The tree always shows exactly
+//! one machine — the active endpoint — so switching machines swaps the whole
+//! sidebar the way Personal/Work swaps Spaces; the header names the machine
+//! whenever more than one is saved. Repository headers are navigation groups,
+//! not duplicate Space cards. A blank gap row separates consecutive Space
+//! groups, never leading or trailing; gap rows are inert.
+use super::render::{display_width, put_right_text, put_text, ShellRenderState};
+use super::*;
+use ratatui::{
+    text::{Line, Span},
+    widgets::{Paragraph, Widget},
+};
+
+/// Reserved workspace metadata token: any source may set it non-empty via
+/// `workspace.report_metadata` to hide that Space from the sidebar. The focused
+/// Space (and, while navigating, the selected one) always stays visible so
+/// focus and selection can never point at a hidden row.
+pub(crate) const SIDEBAR_HIDDEN_TOKEN: &str = "sidebar_hidden";
+
+/// Reserved workspace metadata tokens for the checkout's pull request (the
+/// local pr-status plugin reports them). With a number, the tree names the
+/// Space `#<number> <title>` instead of its branch or custom name, led by a
+/// glyph for a known state: `open`, `draft`, `merged` or `closed`.
+pub(crate) const PR_NUMBER_TOKEN: &str = "pr_number";
+pub(crate) const PR_TITLE_TOKEN: &str = "pr_title";
+pub(crate) const PR_STATE_TOKEN: &str = "pr_state";
+
+fn workspace_token<'a>(workspace: &'a ClientShellWorkspace, key: &str) -> Option<&'a str> {
+    workspace
+        .tokens
+        .iter()
+        .find(|(name, value)| name == key && !value.trim().is_empty())
+        .map(|(_, value)| value.as_str())
+}
+
+fn pull_request_label(workspace: &ClientShellWorkspace) -> Option<String> {
+    let number = workspace_token(workspace, PR_NUMBER_TOKEN)?;
+    Some(match workspace_token(workspace, PR_TITLE_TOKEN) {
+        Some(title) => format!("#{number} {title}"),
+        None => format!("#{number}"),
+    })
+}
+
+/// Nerd Font Octicons in the palette's nearest GitHub state colours.
+fn pull_request_glyph(
+    workspace: &ClientShellWorkspace,
+    palette: &Palette,
+) -> Option<(&'static str, ratatui::style::Color)> {
+    workspace_token(workspace, PR_NUMBER_TOKEN)?;
+    match workspace_token(workspace, PR_STATE_TOKEN)? {
+        "open" => Some(("\u{f407}", palette.green)),
+        "draft" => Some(("\u{f4dd}", palette.overlay0)),
+        "merged" => Some(("\u{f419}", palette.mauve)),
+        "closed" => Some(("\u{f4dc}", palette.red)),
+        _ => None,
+    }
+}
+
+pub(super) fn workspace_sidebar_hidden(
+    workspace: &ClientShellWorkspace,
+    keep_visible: Option<&str>,
+) -> bool {
+    if workspace.focused || keep_visible == Some(workspace.workspace_id.as_str()) {
+        return false;
+    }
+    workspace
+        .tokens
+        .iter()
+        .any(|(key, value)| key == SIDEBAR_HIDDEN_TOKEN && !value.is_empty())
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) enum TreeRow {
+    Repository {
+        endpoint: usize,
+        index: usize,
+        key: String,
+    },
+    Space {
+        endpoint: usize,
+        index: usize,
+        indented: bool,
+    },
+    Agent {
+        endpoint: usize,
+        index: usize,
+        pane_id: String,
+        indented: bool,
+    },
+    /// Blank separator. `depth` is the level of the group that follows, so
+    /// branch continuations stay connected inside a repository and stop before
+    /// the next top-level entry.
+    Gap { depth: usize },
+}
+
+impl TreeRow {
+    fn depth(&self) -> usize {
+        match self {
+            Self::Repository { .. } => 0,
+            Self::Space { indented, .. } => usize::from(*indented),
+            Self::Agent { indented, .. } => 1 + usize::from(*indented),
+            Self::Gap { depth } => *depth,
+        }
+    }
+
+    fn endpoint(&self) -> Option<usize> {
+        match self {
+            Self::Repository { endpoint, .. }
+            | Self::Space { endpoint, .. }
+            | Self::Agent { endpoint, .. } => Some(*endpoint),
+            Self::Gap { .. } => None,
+        }
+    }
+}
+
+pub(super) struct TreeInputs<'a> {
+    pub(super) endpoints: &'a [ClientShellEndpoint],
+    pub(super) collapsed_groups: &'a HashSet<String>,
+    pub(super) remote_collapsed_groups: &'a HashMap<ClientEndpointId, HashSet<String>>,
+    pub(super) collapsed_space_agents: &'a HashSet<(ClientEndpointId, String)>,
+    pub(super) active_endpoint_id: &'a ClientEndpointId,
+    /// Navigate-mode selection on the active endpoint; never hidden.
+    pub(super) keep_visible: Option<&'a str>,
+    pub(super) agent_panel_sort: crate::config::AgentPanelSortConfig,
+}
+
+impl TreeInputs<'_> {
+    pub(super) fn group_collapsed(&self, endpoint_id: &ClientEndpointId, key: &str) -> bool {
+        if endpoint_id.is_local() {
+            self.collapsed_groups.contains(key)
+        } else {
+            self.remote_collapsed_groups.get(endpoint_id)
+                .is_some_and(|groups| groups.contains(key))
+        }
+    }
+}
+
+fn visible_workspaces(snapshot: &ClientShellSnapshot, keep_visible: Option<&str>) -> Vec<usize> {
+    snapshot
+        .workspaces
+        .iter()
+        .enumerate()
+        .filter(|(_, workspace)| !workspace_sidebar_hidden(workspace, keep_visible))
+        .map(|(index, _)| index)
+        .collect()
+}
+
+/// Visible members of a worktree group: the main checkout first, then linked
+/// worktrees in snapshot order.
+fn group_members(snapshot: &ClientShellSnapshot, visible: &[usize], key: &str) -> Vec<usize> {
+    let mut members = visible
+        .iter()
+        .copied()
+        .filter(|index| {
+            snapshot.workspaces[*index]
+                .worktree
+                .as_ref()
+                .is_some_and(|worktree| worktree.key == key)
+        })
+        .collect::<Vec<_>>();
+    members.sort_by_key(|index| {
+        snapshot.workspaces[*index]
+            .worktree
+            .as_ref()
+            .is_some_and(|worktree| worktree.is_linked_worktree)
+    });
+    members
+}
+
+fn is_linked_worktree(snapshot: &ClientShellSnapshot, index: usize) -> bool {
+    snapshot.workspaces[index]
+        .worktree
+        .as_ref()
+        .is_some_and(|worktree| worktree.is_linked_worktree)
+}
+
+/// A visible linked worktree's group: all visible members in tree order and
+/// the linked ones among them. None unless there is a sibling to reorder with.
+pub(super) fn linked_worktree_siblings(
+    snapshot: &ClientShellSnapshot,
+    keep_visible: Option<&str>,
+    workspace_id: &str,
+) -> Option<(Vec<usize>, Vec<usize>)> {
+    let visible = visible_workspaces(snapshot, keep_visible);
+    let source = visible
+        .iter()
+        .copied()
+        .find(|index| snapshot.workspaces[*index].workspace_id == workspace_id)?;
+    let worktree = snapshot.workspaces[source]
+        .worktree
+        .as_ref()
+        .filter(|worktree| worktree.is_linked_worktree)?;
+    let members = group_members(snapshot, &visible, &worktree.key);
+    let linked = members
+        .iter()
+        .copied()
+        .filter(|index| is_linked_worktree(snapshot, *index))
+        .collect::<Vec<_>>();
+    (linked.len() > 1).then_some((members, linked))
+}
+
+/// Move a linked worktree before a visible linked sibling (`None`: after the
+/// last). The whole visible group is rewritten as one block at its earliest
+/// member, where the tree anchors it, so neighbouring entries and Spaces
+/// hidden by `sidebar_hidden` keep their relative order. The main checkout
+/// stays first. None for a no-op or a target outside the group.
+pub(super) fn worktree_move_method(
+    snapshot: &ClientShellSnapshot,
+    keep_visible: Option<&str>,
+    workspace_id: &str,
+    before_workspace_id: Option<&str>,
+) -> Option<crate::api::schema::Method> {
+    let (members, linked) = linked_worktree_siblings(snapshot, keep_visible, workspace_id)?;
+    let id = |index: usize| snapshot.workspaces[index].workspace_id.clone();
+    let mut order = linked
+        .iter()
+        .copied()
+        .filter(|index| snapshot.workspaces[*index].workspace_id != workspace_id)
+        .collect::<Vec<_>>();
+    let insert = match before_workspace_id {
+        Some(target) => order
+            .iter()
+            .position(|index| snapshot.workspaces[*index].workspace_id == target)?,
+        None => order.len(),
+    };
+    let source = linked
+        .iter()
+        .copied()
+        .find(|index| snapshot.workspaces[*index].workspace_id == workspace_id)?;
+    order.insert(insert, source);
+    if order == linked {
+        return None;
+    }
+    let anchor = members.iter().copied().min()?;
+    let before = (anchor + 1..snapshot.workspaces.len())
+        .find(|index| !members.contains(index))
+        .map(id);
+    let workspace_ids = members
+        .iter()
+        .copied()
+        .filter(|index| !is_linked_worktree(snapshot, *index))
+        .chain(order)
+        .map(id)
+        .collect();
+    Some(crate::api::schema::Method::WorkspaceMoveBlock(
+        crate::api::schema::WorkspaceMoveBlockParams {
+            workspace_ids,
+            before_workspace_id: before,
+        },
+    ))
+}
+
+/// Keyboard step: one place up or down among linked siblings, stopping at
+/// either end rather than wrapping.
+pub(super) fn worktree_step_method(
+    snapshot: &ClientShellSnapshot,
+    keep_visible: Option<&str>,
+    workspace_id: &str,
+    down: bool,
+) -> Option<crate::api::schema::Method> {
+    let (_, linked) = linked_worktree_siblings(snapshot, keep_visible, workspace_id)?;
+    let position = linked
+        .iter()
+        .position(|index| snapshot.workspaces[*index].workspace_id == workspace_id)?;
+    let before = if down {
+        if position + 1 >= linked.len() {
+            return None;
+        }
+        linked.get(position + 2)
+    } else {
+        Some(linked.get(position.checked_sub(1)?)?)
+    };
+    let before = before.map(|index| snapshot.workspaces[*index].workspace_id.as_str());
+    worktree_move_method(snapshot, keep_visible, workspace_id, before)
+}
+
+/// Drop slots while dragging a linked worktree: the document row that shows
+/// the indicator and the sibling the source would precede (`None`: after the
+/// last). Only the source's own visible group is offered.
+pub(super) fn worktree_drop_slots(
+    inputs: &TreeInputs<'_>,
+    workspace_id: &str,
+) -> Vec<(Option<String>, usize)> {
+    let Some(snapshot) = active_endpoint_index(inputs)
+        .and_then(|endpoint| inputs.endpoints[endpoint].snapshot.as_deref())
+    else {
+        return Vec::new();
+    };
+    let Some((_, linked)) = linked_worktree_siblings(snapshot, inputs.keep_visible, workspace_id)
+    else {
+        return Vec::new();
+    };
+    let rows = document(inputs);
+    let position = |member: usize| {
+        rows.iter()
+            .position(|row| matches!(row, TreeRow::Space { index, .. } if *index == member))
+    };
+    let mut slots = Vec::new();
+    for &member in &linked {
+        // A folded repository has no rows to drop between.
+        let Some(row) = position(member) else {
+            return Vec::new();
+        };
+        slots.push((
+            Some(snapshot.workspaces[member].workspace_id.clone()),
+            row.saturating_sub(1),
+        ));
+    }
+    // After the last sibling's conversations.
+    let last = linked
+        .last()
+        .copied()
+        .and_then(position)
+        .unwrap_or_default();
+    let end = rows[last + 1..]
+        .iter()
+        .position(|row| !matches!(row, TreeRow::Agent { .. }))
+        .map_or(rows.len(), |offset| last + 1 + offset);
+    slots.push((None, end));
+    slots
+}
+
+/// Agents in panel order, each with its workspace id.
+fn ordered_agents(
+    snapshot: &ClientShellSnapshot,
+    sort: crate::config::AgentPanelSortConfig,
+) -> Vec<(String, String)> {
+    super::agent_sidebar::ordered_agent_pane_ids(snapshot, sort)
+        .into_iter()
+        .filter_map(|pane_id| {
+            let agent = snapshot
+                .agents
+                .iter()
+                .find(|agent| agent.pane_id == pane_id)?;
+            Some((pane_id, agent.workspace_id.clone()))
+        })
+        .collect()
+}
+
+pub(super) fn space_agents_expanded(
+    inputs: &TreeInputs<'_>,
+    endpoint_id: &ClientEndpointId,
+    workspace_id: &str,
+) -> bool {
+    !inputs
+        .collapsed_space_agents
+        .contains(&(endpoint_id.clone(), workspace_id.to_owned()))
+}
+
+fn push_space(
+    rows: &mut Vec<TreeRow>,
+    inputs: &TreeInputs<'_>,
+    endpoint: usize,
+    snapshot: &ClientShellSnapshot,
+    agents: &[(String, String)],
+    index: usize,
+    indented: bool,
+) {
+    rows.push(TreeRow::Space {
+        endpoint,
+        index,
+        indented,
+    });
+    let workspace = &snapshot.workspaces[index];
+    if space_agents_expanded(
+        inputs,
+        &inputs.endpoints[endpoint].endpoint_id,
+        &workspace.workspace_id,
+    ) {
+        for (pane_id, workspace_id) in agents {
+            if workspace_id == &workspace.workspace_id {
+                rows.push(TreeRow::Agent {
+                    endpoint,
+                    index,
+                    pane_id: pane_id.clone(),
+                    indented,
+                });
+            }
+        }
+    }
+}
+
+fn endpoint_rows(rows: &mut Vec<TreeRow>, inputs: &TreeInputs<'_>, endpoint: usize) {
+    let Some(snapshot) = inputs.endpoints[endpoint].snapshot.as_deref() else {
+        return;
+    };
+    let keep_visible = if &inputs.endpoints[endpoint].endpoint_id == inputs.active_endpoint_id {
+        inputs.keep_visible
+    } else {
+        None
+    };
+    let visible = visible_workspaces(snapshot, keep_visible);
+    let agents = ordered_agents(snapshot, inputs.agent_panel_sort);
+    let mut emitted = HashSet::new();
+    let start = rows.len();
+    for &index in &visible {
+        if !emitted.insert(index) {
+            continue;
+        }
+        if rows.len() > start {
+            rows.push(TreeRow::Gap { depth: 0 });
+        }
+        let members = snapshot.workspaces[index]
+            .worktree
+            .as_ref()
+            .map_or_else(Vec::new, |worktree| {
+                group_members(snapshot, &visible, &worktree.key)
+            });
+        // A linked checkout still belongs under its repository when the main
+        // checkout is closed or in the other environment. Never invent a Space.
+        let grouped = members.len() > 1
+            || members.iter().any(|member| {
+                snapshot.workspaces[*member]
+                    .worktree
+                    .as_ref()
+                    .is_some_and(|worktree| worktree.is_linked_worktree)
+            });
+        if grouped {
+            emitted.extend(members.iter().copied());
+            let key = snapshot.workspaces[index]
+                .worktree
+                .as_ref()
+                .map(|worktree| worktree.key.clone())
+                .unwrap_or_default();
+            rows.push(TreeRow::Repository {
+                endpoint,
+                index: members[0],
+                key: key.clone(),
+            });
+            if !inputs.group_collapsed(&inputs.endpoints[endpoint].endpoint_id, &key) {
+                for (position, member) in members.into_iter().enumerate() {
+                    if position > 0 {
+                        rows.push(TreeRow::Gap { depth: 1 });
+                    }
+                    push_space(rows, inputs, endpoint, snapshot, &agents, member, true);
+                }
+            }
+        } else {
+            push_space(rows, inputs, endpoint, snapshot, &agents, index, false);
+        }
+    }
+}
+
+pub(super) fn active_endpoint_index(inputs: &TreeInputs<'_>) -> Option<usize> {
+    inputs
+        .endpoints
+        .iter()
+        .position(|endpoint| &endpoint.endpoint_id == inputs.active_endpoint_id)
+}
+
+/// The active machine's tree. Other machines are separate screens reached with
+/// the machine keys or the header label; they never share this document.
+pub(super) fn document(inputs: &TreeInputs<'_>) -> Vec<TreeRow> {
+    let mut rows = Vec::new();
+    if let Some(endpoint) = active_endpoint_index(inputs) {
+        endpoint_rows(&mut rows, inputs, endpoint);
+    }
+    rows
+}
+
+/// Space order used by visible-order navigation: Space rows plus collapsed
+/// repository headers, exactly as rendered.
+pub(super) fn navigation_entries(inputs: &TreeInputs<'_>) -> Vec<WorkspaceEntry> {
+    let rows = document(inputs);
+    rows.iter()
+        .enumerate()
+        .filter_map(|(position, row)| match row {
+            TreeRow::Space {
+                index, indented, ..
+            } => Some(WorkspaceEntry {
+                index: *index,
+                indented: *indented,
+                last_child: false,
+            }),
+            TreeRow::Repository { index, .. }
+                if rows.get(position + 1).is_none_or(|next| next.depth() == 0) =>
+            {
+                Some(WorkspaceEntry {
+                    index: *index,
+                    indented: false,
+                    last_child: false,
+                })
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+// Tree continuations depend on the complete document, not just the viewport.
+// A gap row only carries continuation bars: it is never a branch of its own.
+fn branch_prefix(rows: &[TreeRow], position: usize) -> String {
+    let row = &rows[position];
+    let depth = row.depth();
+    let branch = !matches!(row, TreeRow::Gap { .. });
+    let mut prefix = String::from(" ");
+    for level in 1..=depth {
+        let has_next = rows[position + 1..]
+            .iter()
+            .find(|row| row.depth() <= level)
+            .is_some_and(|row| row.depth() == level);
+        prefix.push_str(match (branch && level == depth, has_next) {
+            (true, true) => "├─ ",
+            (true, false) => "└─ ",
+            (false, true) => "│  ",
+            (false, false) => "   ",
+        });
+    }
+    prefix
+}
+
+// Ledger metadata wins over the reported status, just like the pane chrome.
+fn attention(agent: &crate::protocol::ClientShellAgent) -> usize {
+    for (rank, token) in ["dot_blocked", "dot_review", "dot_working", "dot_idle"]
+        .iter()
+        .enumerate()
+    {
+        if agent
+            .tokens
+            .iter()
+            .any(|(key, value)| key == token && !value.is_empty())
+        {
+            return rank;
+        }
+    }
+    use crate::api::schema::AgentStatus;
+    match agent.agent_status {
+        AgentStatus::Blocked => 0,
+        AgentStatus::Done => 1,
+        AgentStatus::Working => 2,
+        AgentStatus::Idle | AgentStatus::Unknown => 3,
+    }
+}
+
+fn glyph(palette: &Palette, rank: usize) -> (&'static str, ratatui::style::Color) {
+    match rank {
+        0 => ("◆", palette.red),
+        1 => ("●", palette.peach),
+        2 => ("◐", palette.blue),
+        _ => ("○", palette.overlay0),
+    }
+}
+
+fn counts(
+    snapshot: &ClientShellSnapshot,
+    agents: &[(String, String)],
+    keep_visible: Option<&str>,
+    row: &TreeRow,
+) -> [usize; 4] {
+    let mut counts = [0; 4];
+    let (index, repository) = match row {
+        TreeRow::Repository { index, .. } => (*index, true),
+        TreeRow::Space { index, .. } => (*index, false),
+        _ => return counts,
+    };
+    let key = snapshot.workspaces[index]
+        .worktree
+        .as_ref()
+        .map(|worktree| worktree.key.as_str());
+    for (pane_id, workspace_id) in agents {
+        let Some(workspace) = snapshot
+            .workspaces
+            .iter()
+            .find(|workspace| &workspace.workspace_id == workspace_id)
+        else {
+            continue;
+        };
+        if workspace_sidebar_hidden(workspace, keep_visible) {
+            continue;
+        }
+        let member = if repository {
+            key.is_some()
+                && workspace
+                    .worktree
+                    .as_ref()
+                    .map(|worktree| worktree.key.as_str())
+                    == key
+        } else {
+            &workspace.workspace_id == &snapshot.workspaces[index].workspace_id
+        };
+        if !member {
+            continue;
+        }
+        if let Some(agent) = snapshot
+            .agents
+            .iter()
+            .find(|agent| &agent.pane_id == pane_id)
+        {
+            counts[attention(agent)] += 1;
+        }
+    }
+    counts
+}
+
+fn row_suffix(
+    palette: &Palette,
+    snapshot: &ClientShellSnapshot,
+    agents: &[(String, String)],
+    keep_visible: Option<&str>,
+    row: &TreeRow,
+    width: usize,
+) -> Vec<Span<'static>> {
+    let mut spans = Vec::new();
+    if let TreeRow::Repository { key, .. } = row {
+        let n = group_members(snapshot, &visible_workspaces(snapshot, keep_visible), key).len();
+        spans.push(Span::styled(
+            format!(" {n} {}", if n == 1 { "space" } else { "spaces" }),
+            Style::default().fg(palette.overlay0),
+        ));
+    }
+    for (rank, count) in counts(snapshot, agents, keep_visible, row)
+        .into_iter()
+        .enumerate()
+        .filter(|(_, count)| *count > 0)
+    {
+        let (symbol, color) = glyph(palette, rank);
+        spans.push(Span::styled(
+            format!(" {symbol} {count}"),
+            Style::default().fg(color),
+        ));
+    }
+    // Same budget for render and hit-testing. Protect the label in narrow views.
+    let budget = width.saturating_sub(1 + row.depth() * 3 + 8);
+    let mut used = 0;
+    spans
+        .into_iter()
+        .take_while(|span| {
+            used += unicode_width::UnicodeWidthStr::width(span.content.as_ref());
+            used <= budget
+        })
+        .collect()
+}
+
+fn suffix_rect(rect: Rect, spans: &[Span<'_>]) -> Rect {
+    let width = spans
+        .iter()
+        .map(|span| unicode_width::UnicodeWidthStr::width(span.content.as_ref()))
+        .sum::<usize>()
+        .min(rect.width as usize) as u16;
+    Rect::new(rect.right() - width, rect.y, width, rect.height)
+}
+
+fn agent_label(
+    config: &ClientShellConfig,
+    snapshot: &ClientShellSnapshot,
+    agent: &crate::protocol::ClientShellAgent,
+) -> String {
+    use crate::config::AgentSidebarToken;
+    let canonical_agent = agent
+        .agent
+        .as_deref()
+        .and_then(crate::detect::parse_agent_label);
+    let tokens = agent.tokens.iter().cloned().collect::<HashMap<_, _>>();
+    let pane_label = agent.title.clone().or_else(|| {
+        snapshot
+            .panes
+            .iter()
+            .find(|pane| pane.pane_id == agent.pane_id)
+            .and_then(|pane| pane.label.clone())
+    });
+    let tab_label = snapshot
+        .tabs
+        .iter()
+        .find(|tab| tab.tab_id == agent.tab_id)
+        .filter(|tab| {
+            tab.custom_label
+                || snapshot
+                    .tabs
+                    .iter()
+                    .filter(|candidate| candidate.workspace_id == agent.workspace_id)
+                    .count()
+                    > 1
+        })
+        .map(|tab| tab.label.clone());
+    config
+        .agents
+        .rows_for_agent(canonical_agent)
+        .iter()
+        .find_map(|row| {
+            let labels = row
+                .iter()
+                .filter_map(|token| match token.parts().0 {
+                    AgentSidebarToken::Custom(name) if !name.starts_with("dot_") => {
+                        tokens.get(name).map(String::as_str)
+                    }
+                    AgentSidebarToken::TerminalTitle => agent.terminal_title.as_deref(),
+                    AgentSidebarToken::TerminalTitleStripped => {
+                        agent.terminal_title_stripped.as_deref()
+                    }
+                    AgentSidebarToken::Pane => pane_label.as_deref(),
+                    _ => None,
+                })
+                .filter(|label| !label.trim().is_empty())
+                .collect::<Vec<_>>();
+            (!labels.is_empty()).then(|| labels.join(" · "))
+        })
+        .or(pane_label)
+        .or(tab_label)
+        .unwrap_or_else(|| "New conversation".to_owned())
+}
+
+fn space_label(workspace: &ClientShellWorkspace, indented: bool) -> String {
+    if let Some(label) = pull_request_label(workspace) {
+        return label;
+    }
+    if !indented {
+        return workspace.label.clone();
+    }
+    // Keep meaningful custom Space names, but do not repeat the repository
+    // heading when a branch identifies the checkout.
+    let custom = workspace.custom_label
+        && workspace
+            .worktree
+            .as_ref()
+            .is_none_or(|worktree| worktree.label != workspace.label);
+    if custom {
+        return workspace.label.clone();
+    }
+    workspace
+        .branch
+        .as_deref()
+        .map(|branch| branch.strip_prefix("worktree/").unwrap_or(branch))
+        .unwrap_or(&workspace.label)
+        .to_owned()
+}
+
+/// Rows in view for one composed frame, with their absolute document positions.
+struct Viewport {
+    body: Rect,
+    content_width: u16,
+    metrics: crate::pane::ScrollMetrics,
+    start: usize,
+}
+
+fn viewport(rows: &[TreeRow], body: Rect, requested_start: usize) -> Viewport {
+    let heights = vec![1u16; rows.len()];
+    let gaps = vec![0u16; rows.len()];
+    let metrics = super::scroll::list_scroll_metrics(&heights, &gaps, body.height, requested_start);
+    let show_scrollbar = metrics.max_offset_from_bottom > 0 && body.width > 1;
+    Viewport {
+        body,
+        content_width: body.width.saturating_sub(u16::from(show_scrollbar)),
+        metrics,
+        start: metrics
+            .max_offset_from_bottom
+            .saturating_sub(metrics.offset_from_bottom),
+    }
+}
+
+fn reveal_target(inputs: &TreeInputs<'_>, rows: &[TreeRow]) -> Option<usize> {
+    let endpoint = active_endpoint_index(inputs)?;
+    let snapshot = inputs.endpoints[endpoint].snapshot.as_deref()?;
+    let focused_pane = inputs.keep_visible.is_none().then_some(snapshot.focused_pane_id.as_deref()).flatten();
+    let focused_workspace = inputs.keep_visible.or(snapshot.focused_workspace_id.as_deref());
+    rows.iter()
+        .position(|row| {
+            matches!(row, TreeRow::Agent { endpoint: row_endpoint, pane_id, .. }
+                if *row_endpoint == endpoint && Some(pane_id.as_str()) == focused_pane)
+        })
+        .or_else(|| {
+            rows.iter().position(|row| match row {
+                TreeRow::Space {
+                    endpoint: row_endpoint,
+                    index,
+                    ..
+                }
+                | TreeRow::Repository {
+                    endpoint: row_endpoint,
+                    index,
+                    ..
+                } => {
+                    *row_endpoint == endpoint
+                        && Some(snapshot.workspaces[*index].workspace_id.as_str())
+                            == focused_workspace
+                }
+                _ => false,
+            })
+        })
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn render_tree(
+    buffer: &mut Buffer,
+    area: Rect,
+    active_snapshot: Option<&ClientShellSnapshot>,
+    config: &ClientShellConfig,
+    state: &mut ShellRenderState<'_>,
+    hits: &mut ShellHitMap,
+) {
+    let palette = &config.palette;
+    super::render::render_sidebar_background(buffer, area, palette);
+    hits.sidebar_divider = if area.is_empty() {
+        Rect::default()
+    } else {
+        Rect::new(area.right().saturating_sub(1), area.y, 1, area.height)
+    };
+    let (workspace_area, _) = crate::ui::expanded_sidebar_sections(area, 1.0);
+    hits.sidebar_section_divider = Rect::default();
+    put_text(
+        buffer,
+        workspace_area.x,
+        workspace_area.y,
+        workspace_area.width,
+        " spaces",
+        Style::default()
+            .fg(palette.overlay0)
+            .add_modifier(Modifier::BOLD),
+    );
+    // With more than one saved machine the header names the one on screen;
+    // clicking it switches to the next online machine, like the machine key.
+    if state.endpoints.len() > 1 {
+        let label = state
+            .endpoints
+            .iter()
+            .find(|endpoint| &endpoint.endpoint_id == state.active_endpoint_id)
+            .map_or("Local", |endpoint| endpoint.label.as_str());
+        let label =
+            crate::ui::truncate_end(label, usize::from(workspace_area.width.saturating_sub(9)));
+        let width = display_width(&label).min(workspace_area.width);
+        let rect = Rect::new(
+            workspace_area.right().saturating_sub(width),
+            workspace_area.y,
+            width,
+            u16::from(workspace_area.height > 0 && width > 0),
+        );
+        put_text(
+            buffer,
+            rect.x,
+            rect.y,
+            rect.width,
+            &label,
+            Style::default()
+                .fg(palette.accent)
+                .add_modifier(Modifier::BOLD),
+        );
+        if config.mouse_capture {
+            hits.machine_switch = rect;
+        }
+    }
+
+    let inputs = TreeInputs {
+        endpoints: state.endpoints,
+        collapsed_groups: state.collapsed_groups,
+        remote_collapsed_groups: state.remote_collapsed_groups,
+        collapsed_space_agents: state.collapsed_space_agents,
+        active_endpoint_id: state.active_endpoint_id,
+        keep_visible: state.selected_workspace_id
+            .filter(|target| &target.endpoint_id == state.active_endpoint_id)
+            .map(|target| target.workspace_id.as_str()),
+        agent_panel_sort: config.agent_panel_sort,
+    };
+    let rows = document(&inputs);
+    let body = Rect::new(
+        workspace_area.x,
+        workspace_area.y.saturating_add(WORKSPACE_HEADER_ROWS),
+        workspace_area.width,
+        workspace_area
+            .height
+            .saturating_sub(WORKSPACE_HEADER_ROWS + 1),
+    );
+    hits.workspace_body = body;
+    let mut view = viewport(&rows, body, *state.workspace_scroll);
+    let reveal_focus = std::mem::take(state.reveal_focused_workspace);
+    let reveal_navigation = std::mem::take(state.reveal_navigation_workspace);
+    if !body.is_empty() && (reveal_focus || reveal_navigation) {
+        if let Some(target) = reveal_target(&inputs, &rows) {
+            let heights = vec![1u16; rows.len()];
+            let gaps = vec![0u16; rows.len()];
+            let start = super::scroll::list_scroll_start_to_reveal(
+                &heights,
+                &gaps,
+                body.height,
+                view.start,
+                target,
+            );
+            view = viewport(&rows, body, start);
+        }
+    }
+    hits.workspace_max_scroll = view.metrics.max_offset_from_bottom;
+    hits.workspace_scroll_metrics = Some(view.metrics);
+    *state.workspace_scroll = view.start;
+
+    // Per-endpoint agent lists are cheap to rebuild once per frame.
+    let endpoint_agents = state
+        .endpoints
+        .iter()
+        .map(|endpoint| {
+            endpoint
+                .snapshot
+                .as_deref()
+                .map_or_else(Vec::new, |snapshot| {
+                    ordered_agents(snapshot, config.agent_panel_sort)
+                })
+        })
+        .collect::<Vec<_>>();
+
+    for (offset, position) in (view.start..rows.len())
+        .take(usize::from(view.body.height))
+        .enumerate()
+    {
+        let row = &rows[position];
+        let rect = Rect::new(
+            view.body.x,
+            view.body.y + offset as u16,
+            view.content_width,
+            1,
+        );
+        let Some(endpoint_index) = row.endpoint() else {
+            // Gap: only the branch continuation, no label, counts, or highlight.
+            let prefix = branch_prefix(&rows, position);
+            put_text(
+                buffer,
+                rect.x,
+                rect.y,
+                rect.width,
+                &prefix,
+                Style::default().fg(palette.overlay0),
+            );
+            continue;
+        };
+        let endpoint = &state.endpoints[endpoint_index];
+        let endpoint_active = &endpoint.endpoint_id == state.active_endpoint_id;
+        let stale = endpoint.status != ClientEndpointStatus::Online;
+        let Some(snapshot) = endpoint.snapshot.as_deref() else {
+            continue;
+        };
+        let keep_visible = inputs.keep_visible;
+        let agents = &endpoint_agents[endpoint_index];
+        let prefix = branch_prefix(&rows, position);
+        let prefix_width = display_width(&prefix);
+        let right = row_suffix(
+            palette,
+            snapshot,
+            agents,
+            keep_visible,
+            row,
+            usize::from(rect.width),
+        );
+        let suffix = suffix_rect(rect, &right);
+        let label_width = usize::from(rect.width.saturating_sub(prefix_width + suffix.width));
+        let mut spans = vec![Span::styled(prefix, Style::default().fg(palette.overlay0))];
+        let mut style = Style::default();
+        match row {
+            TreeRow::Repository { index, key, .. } => {
+                let workspace = &snapshot.workspaces[*index];
+                let label = workspace
+                    .worktree
+                    .as_ref()
+                    .map_or(workspace.label.as_str(), |worktree| worktree.label.as_str());
+                if inputs.group_collapsed(&endpoint.endpoint_id, key) {
+                    let belongs = |workspace: &ClientShellWorkspace| {
+                        workspace
+                            .worktree
+                            .as_ref()
+                            .is_some_and(|worktree| &worktree.key == key)
+                    };
+                    let active = endpoint_active
+                        && snapshot
+                            .workspaces
+                            .iter()
+                            .any(|workspace| workspace.focused && belongs(workspace));
+                    let selected = endpoint_active
+                        && snapshot.workspaces.iter().any(|workspace| {
+                            keep_visible == Some(workspace.workspace_id.as_str())
+                                && belongs(workspace)
+                        });
+                    if selected {
+                        style = style.bg(palette.selection_bg);
+                    } else if active {
+                        style = style.bg(palette.active_row_bg);
+                    }
+                }
+                spans.push(Span::styled(
+                    crate::ui::truncate_end(label, label_width),
+                    Style::default()
+                        .fg(palette.accent)
+                        .add_modifier(Modifier::BOLD),
+                ));
+                hits.workspaces.push(WorkspaceHit {
+                    rect,
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                    workspace_id: workspace.workspace_id.clone(),
+                    indented: false,
+                    group_toggle: Some((rect, key.clone())),
+                });
+            }
+            TreeRow::Space {
+                index, indented, ..
+            } => {
+                let workspace = &snapshot.workspaces[*index];
+                let active = endpoint_active && workspace.focused;
+                let selected = endpoint_active
+                    && keep_visible == Some(workspace.workspace_id.as_str());
+                let dragged = endpoint_active
+                    && state.dragged_workspace_id == Some(workspace.workspace_id.as_str());
+                if selected {
+                    style = style.bg(palette.selection_bg);
+                } else if dragged {
+                    style = style.bg(palette.surface1);
+                } else if active {
+                    style = style.bg(palette.active_row_bg);
+                }
+                let label = space_label(workspace, *indented);
+                let mut label_width = label_width;
+                if let Some((symbol, color)) = pull_request_glyph(workspace, palette) {
+                    let glyph = format!("{symbol} ");
+                    label_width = label_width.saturating_sub(usize::from(display_width(&glyph)));
+                    spans.push(Span::styled(glyph, Style::default().fg(color)));
+                }
+                let status = workspace.agent_status;
+                let token_values = workspace.tokens.iter().cloned().collect::<HashMap<_, _>>();
+                let token_rows = crate::ui::sidebar_space_rows(
+                    &config.spaces,
+                    crate::ui::SpaceTokenContext {
+                        workspace: &label,
+                        branch: workspace.branch.as_deref(),
+                        state_text: status_text(status),
+                        ahead_behind: workspace.git_ahead_behind,
+                        tokens: &token_values,
+                        suppress_git_details: *indented,
+                    },
+                );
+                if let Some(token_row) = token_rows.first() {
+                    let token_row = token_row
+                        .iter()
+                        .filter(|token| {
+                            !matches!(token.kind, crate::ui::ResolvedTokenKind::StateIcon)
+                        })
+                        .cloned()
+                        .collect::<Vec<_>>();
+                    spans.extend(crate::ui::resolved_token_spans(
+                        &token_row,
+                        (
+                            status_icon(status, config.status_indicators),
+                            Style::default().fg(status_color(status, palette)),
+                        ),
+                        Style::default().fg(palette.overlay0),
+                        Style::default()
+                            .fg(if active || selected || dragged {
+                                palette.text
+                            } else {
+                                palette.subtext0
+                            })
+                            .add_modifier(Modifier::BOLD),
+                        Style::default().fg(palette.mauve),
+                        Style::default().fg(palette.overlay0),
+                        palette,
+                        label_width,
+                    ));
+                }
+                hits.workspaces.push(WorkspaceHit {
+                    rect,
+                    endpoint_id: endpoint.endpoint_id.clone(),
+                    workspace_id: workspace.workspace_id.clone(),
+                    indented: *indented,
+                    group_toggle: None,
+                });
+                if suffix.width > 0 {
+                    hits.agent_toggles.push((
+                        suffix,
+                        endpoint.endpoint_id.clone(),
+                        workspace.workspace_id.clone(),
+                    ));
+                }
+            }
+            TreeRow::Agent { pane_id, .. } => {
+                let Some(agent) = snapshot
+                    .agents
+                    .iter()
+                    .find(|agent| &agent.pane_id == pane_id)
+                else {
+                    continue;
+                };
+                let (symbol, color) = glyph(palette, attention(agent));
+                if endpoint_active && agent.focused {
+                    style = style.bg(palette.active_row_bg);
+                }
+                spans.push(Span::styled(
+                    format!("{symbol} "),
+                    Style::default().fg(color),
+                ));
+                spans.push(Span::styled(
+                    crate::ui::truncate_end(
+                        &agent_label(config, snapshot, agent),
+                        label_width.saturating_sub(2),
+                    ),
+                    Style::default().fg(palette.text),
+                ));
+                hits.agents.push((rect, pane_id.clone()));
+            }
+            TreeRow::Gap { .. } => unreachable!("handled above"),
+        }
+        if stale {
+            style = style.fg(palette.overlay0).add_modifier(Modifier::DIM);
+        }
+        Paragraph::new(Line::from(spans))
+            .style(style)
+            .render(rect, buffer);
+        if suffix.width > 0 {
+            Paragraph::new(Line::from(right))
+                .style(style)
+                .render(suffix, buffer);
+        }
+    }
+
+    if view.metrics.max_offset_from_bottom > 0 && body.width > 1 {
+        let track = Rect::new(body.right().saturating_sub(1), body.y, 1, body.height);
+        hits.workspace_scrollbar = track;
+        super::scroll::render_list_scrollbar(buffer, track, view.metrics, palette);
+    }
+
+    if let Some(row) = state.workspace_drop_indicator_row.filter(|row| {
+        *row >= workspace_area.y.saturating_add(1)
+            && *row < workspace_area.bottom().saturating_sub(1)
+    }) {
+        put_text(
+            buffer,
+            body.x,
+            row,
+            body.width,
+            &"─".repeat(body.width as usize),
+            Style::default().fg(palette.accent),
+        );
+    }
+
+    // Fixed footer: the informational view label at left, Menu at right. There
+    // is no New button; a zero-size rect keeps the footer row known to drag
+    // targeting without creating a hit.
+    // The footer shares its row with the sidebar collapse toggle.
+    let footer_y = workspace_area.bottom().saturating_sub(1);
+    let footer = Rect::new(
+        workspace_area.x,
+        footer_y,
+        workspace_area.width.saturating_sub(2),
+        u16::from(workspace_area.height > 0),
+    );
+    hits.new_workspace = Rect::new(footer.x, footer_y, 0, 0);
+    let attention = active_snapshot.is_some_and(super::global_menu::global_menu_attention);
+    let launcher_width = if config.mouse_capture {
+        if attention { 8 } else { 6 }.min(footer.width)
+    } else {
+        0
+    };
+    hits.global_launcher = Rect::new(
+        footer.right().saturating_sub(launcher_width),
+        footer_y,
+        launcher_width,
+        u16::from(footer.height > 0 && launcher_width > 0),
+    );
+    if let Some(label) = active_snapshot.and_then(|snapshot| snapshot.agent_view_label.as_deref()) {
+        let label_width = footer
+            .width
+            .saturating_sub(launcher_width)
+            .saturating_sub(1);
+        put_text(
+            buffer,
+            footer.x,
+            footer_y,
+            label_width.saturating_add(1),
+            &format!(
+                " {}",
+                crate::ui::truncate_end(label, usize::from(label_width))
+            ),
+            Style::default().fg(palette.accent),
+        );
+    }
+    if config.mouse_capture {
+        put_right_text(
+            buffer,
+            footer,
+            footer_y,
+            if attention { "● menu" } else { "menu" },
+            Style::default().fg(if attention {
+                palette.accent
+            } else {
+                palette.overlay0
+            }),
+        );
+    }
+
+    hits.sidebar_toggle = Rect::new(
+        area.right().saturating_sub(2),
+        area.bottom().saturating_sub(1),
+        u16::from(area.width > 1),
+        u16::from(area.height > 0),
+    );
+    put_text(
+        buffer,
+        hits.sidebar_toggle.x,
+        hits.sidebar_toggle.y,
+        hits.sidebar_toggle.width,
+        "«",
+        Style::default().fg(palette.overlay0),
+    );
+}
+
+/// Collapsed sidebar in tree mode: the active machine's filtered Space
+/// indicators only, one active view marker (and machine initial) above the
+/// toggle, and no Agents section.
+pub(super) fn render_collapsed_tree(
+    buffer: &mut Buffer,
+    area: Rect,
+    snapshot: &ClientShellSnapshot,
+    config: &ClientShellConfig,
+    active_endpoint_id: &ClientEndpointId,
+    machine_label: Option<&str>,
+    selected_workspace_id: Option<&str>,
+    hits: &mut ShellHitMap,
+) {
+    let palette = &config.palette;
+    super::render::render_sidebar_background(buffer, area, palette);
+    let content = Rect::new(area.x, area.y, area.width.saturating_sub(1), area.height);
+    let workspace_area = Rect::new(
+        content.x,
+        content.y,
+        content.width,
+        content.height.saturating_sub(2),
+    );
+    let divider_y = (content.height >= 2).then(|| content.bottom().saturating_sub(2));
+    for (row, entry) in
+        super::sidebar::flat_workspace_entries_keeping(snapshot, selected_workspace_id)
+            .into_iter()
+            .take(workspace_area.height as usize)
+            .enumerate()
+    {
+        let Some(workspace) = snapshot.workspaces.get(entry.index) else {
+            continue;
+        };
+        let rect = Rect::new(
+            workspace_area.x,
+            workspace_area.y + row as u16,
+            workspace_area.width,
+            1,
+        );
+        let selected = selected_workspace_id == Some(workspace.workspace_id.as_str());
+        let selection_background =
+            if workspace.focused && palette.selection_bg == ratatui::style::Color::Reset {
+                palette.active_row_bg
+            } else {
+                palette.selection_bg
+            };
+        if selected {
+            buffer.set_style(rect, Style::default().bg(selection_background));
+        } else if workspace.focused {
+            buffer.set_style(rect, Style::default().bg(palette.active_row_bg));
+        }
+        let number_style = if selected {
+            Style::default()
+                .fg(palette.overlay1)
+                .bg(selection_background)
+        } else if workspace.focused {
+            Style::default().fg(palette.text).bg(palette.active_row_bg)
+        } else {
+            Style::default().fg(palette.overlay0)
+        };
+        put_text(
+            buffer,
+            rect.x,
+            rect.y,
+            rect.width.min(2),
+            &format!("{:<2}", workspace.number),
+            number_style,
+        );
+        let status = workspace.agent_status;
+        put_text(
+            buffer,
+            rect.x.saturating_add(2),
+            rect.y,
+            rect.width.saturating_sub(2),
+            status_icon(status, config.status_indicators),
+            Style::default().fg(status_color(status, palette)),
+        );
+        hits.workspaces.push(WorkspaceHit {
+            rect,
+            endpoint_id: active_endpoint_id.clone(),
+            workspace_id: workspace.workspace_id.clone(),
+            indented: false,
+            group_toggle: None,
+        });
+    }
+    if let Some(divider_y) = divider_y {
+        put_text(
+            buffer,
+            workspace_area.x,
+            divider_y,
+            workspace_area.width,
+            &"─".repeat(workspace_area.width as usize),
+            Style::default().fg(palette.surface_dim),
+        );
+        if let Some(badge) = snapshot
+            .agent_view_label
+            .as_deref()
+            .and_then(|label| label.chars().next())
+            .map(|initial| initial.to_ascii_uppercase().to_string())
+        {
+            put_text(
+                buffer,
+                workspace_area.x,
+                divider_y,
+                1,
+                &badge,
+                Style::default()
+                    .fg(palette.accent)
+                    .add_modifier(Modifier::BOLD),
+            );
+        }
+        if let Some(initial) = machine_label
+            .and_then(|label| label.chars().next())
+            .map(|initial| initial.to_ascii_uppercase().to_string())
+            .filter(|_| workspace_area.width >= 3)
+        {
+            put_text(
+                buffer,
+                workspace_area.right().saturating_sub(1),
+                divider_y,
+                1,
+                &initial,
+                Style::default()
+                    .fg(palette.text)
+                    .add_modifier(Modifier::BOLD),
+            );
+        }
+    }
+    hits.sidebar_toggle = if area.is_empty() || workspace_area.width == 0 {
+        Rect::default()
+    } else {
+        Rect::new(
+            workspace_area.x + workspace_area.width / 2,
+            area.bottom().saturating_sub(1),
+            1,
+            1,
+        )
+    };
+    put_text(
+        buffer,
+        hits.sidebar_toggle.x,
+        hits.sidebar_toggle.y,
+        hits.sidebar_toggle.width,
+        "»",
+        if super::global_menu::global_menu_attention(snapshot) {
+            Style::default()
+                .fg(palette.accent)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(palette.overlay0)
+        },
+    );
+}

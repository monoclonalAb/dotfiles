+) -> Option<PaneAttention> {
+    let terminal = ws
+        .pane_state(pane_id)
+        .and_then(|pane| app.terminals.get(&pane.attached_terminal_id))?;
+    if terminal.metadata_tokens.get("dot_blocked").is_some() {
+        Some(PaneAttention::Blocked)
+    } else if terminal.metadata_tokens.get("dot_review").is_some() {
+        Some(PaneAttention::Review)
+    } else {
+        None
+    }
+}
+
+fn attention_pane_opacity(unfocused_opacity: f32) -> f32 {
+    unfocused_opacity + (1.0 - unfocused_opacity) / 2.0
+}
+
+pub(crate) fn pane_unfocused_opacity(
+    app: &AppState,
+    workspace_index: usize,
+    pane_id: crate::layout::PaneId,
+) -> f32 {
+    app.workspaces
+        .get(workspace_index)
+        .and_then(|ws| pane_attention(app, ws, pane_id))
+        .map_or(app.unfocused_pane_opacity, |_| {
+            attention_pane_opacity(app.unfocused_pane_opacity)
+        })
+}
+
+fn blend_toward(source: Rgb, target: Rgb, opacity: f32) -> Rgb {
+    let blend = |source: u8, target: u8| {
+        (f32::from(source) * opacity + f32::from(target) * (1.0 - opacity)).round() as u8
+    };
+    (
+        blend(source.0, target.0),
+        blend(source.1, target.1),
+        blend(source.2, target.2),
+    )
+}
+
+fn faded_unfocused_style(style: Style, app: &AppState, opacity: f32) -> Style {
+    let backdrop = app
+        .host_terminal_theme
+        .background
+        .map(|color| (color.r, color.g, color.b))
+        .or_else(|| terminal_color_to_rgb(app.palette.surface_dim, app))
+        .unwrap_or((0, 0, 0));
+    let default_fg = app
+        .host_terminal_theme
+        .foreground
+        .map(|color| (color.r, color.g, color.b))
+        .or_else(|| terminal_color_to_rgb(app.palette.text, app))
+        .unwrap_or((192, 192, 192));
+    let fg = style
+        .fg
+        .and_then(|color| terminal_color_to_rgb(color, app))
+        .unwrap_or(default_fg);
+    let bg = style
+        .bg
+        .and_then(|color| terminal_color_to_rgb(color, app))
+        .unwrap_or(backdrop);
+
+    let (fg_r, fg_g, fg_b) = blend_toward(fg, backdrop, opacity);
+    let (bg_r, bg_g, bg_b) = blend_toward(bg, backdrop, opacity);
+    let mut faded = style
+        .fg(Color::Rgb(fg_r, fg_g, fg_b))
+        .bg(Color::Rgb(bg_r, bg_g, bg_b));
+    if let Some(underline) = style
+        .underline_color
+        .and_then(|color| terminal_color_to_rgb(color, app))
+    {
+        let (r, g, b) = blend_toward(underline, backdrop, opacity);
+        faded = faded.underline_color(Color::Rgb(r, g, b));
+    }
+    faded
+}
+
+/// Apply the same fade as a full pane render to one retained-render cell.
+///
+/// PTY dirty-row patches bypass the ratatui pane buffer, so they must be
+/// transformed before replacing cells in the previous frame. Otherwise every
+/// animated update in an unfocused pane briefly restores its undimmed colours.
+pub(crate) fn fade_unfocused_cell_data(
+    app: &AppState,
+    cell: &mut crate::protocol::CellData,
+    opacity: f32,
+) {
+    let style = Style::default()
+        .fg(crate::protocol::u32_to_color(cell.fg))
+        .bg(crate::protocol::u32_to_color(cell.bg));
+    let faded = faded_unfocused_style(style, app, opacity);
+    cell.fg = crate::protocol::color_to_u32(faded.fg.unwrap_or(Color::Reset));
+    cell.bg = crate::protocol::color_to_u32(faded.bg.unwrap_or(Color::Reset));
+}
+
+fn fade_unfocused_pane(app: &AppState, frame: &mut Frame, area: Rect, opacity: f32) {
+    let buf = frame.buffer_mut();
+    for y in area.y..area.y + area.height {
+        for x in area.x..area.x + area.width {
+            let cell = &mut buf[(x, y)];
+            cell.set_style(faded_unfocused_style(cell.style(), app, opacity));
+        }
+    }
+}

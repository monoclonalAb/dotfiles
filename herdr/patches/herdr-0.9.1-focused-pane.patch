+    assert!(rows.iter().any(|row| row.contains("website")));
+
+    // Navigate-mode selection stays visible too, and hidden Spaces are skipped.
+    let mut update = state.snapshot.as_deref().unwrap().clone();
+    update.revision = 4;
+    update.workspaces[1].tokens = vec![(SIDEBAR_HIDDEN_TOKEN.into(), "1".into())];

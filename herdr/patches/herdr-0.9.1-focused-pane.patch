+#[test]
+fn linked_worktree_drags_within_its_repository() {
+    let mut state = tree_state(worktree_fixture(2));
+    let rows = tall_rows(&mut state);
+    assert!(rows[4].starts_with(" repo"), "{:?}", rows[4]);
+    assert!(rows[5].starts_with(" ├─ main"), "{:?}", rows[5]);
+    assert!(rows[7].starts_with(" ├─ alpha"), "{:?}", rows[7]);
+    assert!(rows[9].starts_with(" ├─ beta"), "{:?}", rows[9]);
+    assert!(rows[11].starts_with(" └─ gamma"), "{:?}", rows[11]);
+    assert_eq!(rows[12], "    └─ ○ gamma task");
+    assert!(rows[14].starts_with(" website"), "{:?}", rows[14]);
+    let row = |state: &ClientShellState, id| workspace_row(state, id).expect("Space row");
+    let (alpha, gamma, website) = (
+        row(&state, "ws_3"),
+        row(&state, "ws_5"),
+        row(&state, "ws_6"),
+    );
+
+    // Drag gamma up onto alpha: the indicator sits in the gap above alpha.
+    mouse(
+        &mut state,
+        MouseEventKind::Down(MouseButton::Left),
+        6,
+        gamma,
+    );
+    mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        6,
+        alpha,
+    );
+    assert!(matches!(
+        state.chrome_drag,
+        Some(ClientChromeDrag::Workspace { ref source_workspace_id, target: Some((Some(ref before), 6)) })
+            if source_workspace_id == "ws_5" && before == "ws_3"
+    ));
+    let rows = tall_rows(&mut state);
+    assert!(
+        rows[6].starts_with("───"),
+        "in-group indicator: {:?}",
+        rows[6]
+    );
+    let released = mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 6, alpha);
+    assert!(
+        focus_requests(&released).is_empty(),
+        "a drag does not focus"
+    );
+    assert_eq!(
+        move_blocks(&released),
+        vec![(ids(&["ws_2", "ws_5", "ws_3", "ws_4"]), Some("ws_6".into()))],
+        "one block at the repository's place; the main checkout stays first"
+    );
+
+    // Past the end of the repository clamps to after gamma's conversations.
+    tall_rows(&mut state);
+    mouse(
+        &mut state,
+        MouseEventKind::Down(MouseButton::Left),
+        6,
+        alpha,
+    );
+    mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        6,
+        website,
+    );
+    assert!(matches!(
+        state.chrome_drag,
+        Some(ClientChromeDrag::Workspace {
+            target: Some((None, 13)),
+            ..
+        })
+    ));
+    let released = mouse(
+        &mut state,
+        MouseEventKind::Up(MouseButton::Left),
+        6,
+        website,
+    );
+    assert_eq!(
+        move_blocks(&released),
+        vec![(ids(&["ws_2", "ws_4", "ws_5", "ws_3"]), Some("ws_6".into()))]
+    );
+
+    // Dropping a worktree where it already is sends nothing.
+    tall_rows(&mut state);
+    assert!(move_blocks(&drag(&mut state, gamma, website)).is_empty());
+    // The main checkout still moves the whole repository among top-level rows.
+    tall_rows(&mut state);
+    let main = row(&state, "ws_2");
+    assert_eq!(
+        move_blocks(&drag(&mut state, main, website + 1)),
+        vec![(ids(&["ws_2", "ws_3", "ws_4", "ws_5"]), None)]
+    );
+}

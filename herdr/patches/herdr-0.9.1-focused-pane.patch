+fn tall_rows(state: &mut ClientShellState) -> Vec<String> {
+    let frame = state.compose(106, 24).expect("composed frame");
+    let width = usize::from(state.sidebar_width.saturating_sub(1));
+    frame_rows(&frame)
+        .into_iter()
+        .map(|row| {
+            row.chars()
+                .take(width)
+                .collect::<String>()
+                .trim_end_matches(['▕', '«', '»'])
+                .trim_end()
+                .to_owned()
+        })
+        .collect()
+}
+
+fn mouse(
+    state: &mut ClientShellState,
+    kind: MouseEventKind,
+    column: u16,
+    row: u16,
+) -> ClientShellInput {
+    state.handle_raw_events(vec![RawInputEvent::Mouse(crossterm::event::MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: KeyModifiers::empty(),
+    })])
+}
+
+fn drag(state: &mut ClientShellState, from: u16, to: u16) -> ClientShellInput {
+    mouse(state, MouseEventKind::Down(MouseButton::Left), 6, from);
+    mouse(state, MouseEventKind::Drag(MouseButton::Left), 6, to);
+    mouse(state, MouseEventKind::Up(MouseButton::Left), 6, to)
+}
+
+fn move_blocks(outcome: &ClientShellInput) -> Vec<(Vec<String>, Option<String>)> {
+    outcome
+        .actions
+        .iter()
+        .filter_map(|action| match action {
+            ClientShellAction::Endpoint { request, .. } => match &request.method {
+                crate::api::schema::Method::WorkspaceMoveBlock(params) => Some((
+                    params.workspace_ids.clone(),
+                    params.before_workspace_id.clone(),
+                )),
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect()
+}
+
+fn ids(values: &[&str]) -> Vec<String> {
+    values.iter().map(|value| (*value).to_owned()).collect()
+}
+
+/// The server's `workspace.move_block` ordering, for checking the result.
+fn apply_block(snapshot: &mut ClientShellSnapshot, moved: &[String], before: Option<&str>) {
+    let block = moved
+        .iter()
+        .map(|id| {
+            snapshot
+                .workspaces
+                .iter()
+                .find(|workspace| &workspace.workspace_id == id)
+                .expect("moved Space exists")
+                .clone()
+        })
+        .collect::<Vec<_>>();
+    snapshot
+        .workspaces
+        .retain(|workspace| !moved.contains(&workspace.workspace_id));
+    let at = before
+        .and_then(|id| {
+            snapshot
+                .workspaces
+                .iter()
+                .position(|workspace| workspace.workspace_id == id)
+        })
+        .unwrap_or(snapshot.workspaces.len());
+    snapshot.workspaces.splice(at..at, block);
+}

+//! Inline Spaces tree (`ui.sidebar.spaces.inline_agents`): document shape,
+//! `sidebar_hidden` filtering, disclosure, fixed footer and hit-testing.
+use super::*;
+use crate::client::endpoint::{
+    ClientEndpointId, ClientEndpointStatus, ProfileId, SavedSshEndpoint,
+};
+use crate::client::shell::tree::SIDEBAR_HIDDEN_TOKEN;
+
+fn tree_config() -> ClientShellConfig {
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.inline_agents = true;
+    config.ui.sidebar.spaces.rows = vec![vec![crate::config::SpaceSidebarToken::Workspace]];
+    // The deployed config labels conversations by task title; keep the test
+    // rows explicit so the tree's first-row lookup is what is under test.
+    config.ui.sidebar.agents.rows = vec![vec![
+        crate::config::AgentSidebarToken::StateIcon,
+        crate::config::AgentSidebarToken::TerminalTitleStripped,
+    ]];
+    ClientShellConfig::from_config(&config)
+}
+
+fn workspace(number: usize, label: &str, focused: bool) -> ClientShellWorkspace {
+    ClientShellWorkspace {
+        workspace_id: format!("ws_{number}"),
+        active_tab_id: format!("tab_{number}_1"),
+        new_workspace_cwd: "/repo".into(),
+        number,
+        label: label.into(),
+        custom_label: false,
+        branch: None,
+        git_ahead_behind: None,
+        tokens: Vec::new(),
+        worktree: None,
+        focused,
+        agent_status: AgentStatus::Idle,
+    }
+}
+
+fn tab(workspace: usize, index: usize, focused: bool) -> ClientShellTab {
+    ClientShellTab {
+        tab_id: format!("tab_{workspace}_{index}"),
+        workspace_id: format!("ws_{workspace}"),
+        number: index,
+        label: index.to_string(),
+        custom_label: false,
+        zoomed: false,
+        focused,
+        agent_status: AgentStatus::Idle,
+    }
+}
+
+fn agent(workspace: usize, index: usize, title: &str, focused: bool) -> ClientShellAgent {
+    ClientShellAgent {
+        pane_id: format!("pane_{workspace}_{index}"),
+        workspace_id: format!("ws_{workspace}"),
+        tab_id: format!("tab_{workspace}_{index}"),
+        name: None,
+        display_agent: None,
+        agent: Some("pi".into()),
+        title: None,
+        terminal_title: Some(title.into()),
+        terminal_title_stripped: Some(title.into()),
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 0,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused,
+    }
+}
+
+fn pane(workspace: usize, index: usize, focused: bool) -> ClientShellPane {
+    ClientShellPane {
+        pane_id: format!("pane_{workspace}_{index}"),
+        workspace_id: format!("ws_{workspace}"),
+        tab_id: format!("tab_{workspace}_{index}"),
+        label: None,
+        cwd: None,
+        foreground_cwd: None,
+        focused,
+        right_click_passthrough: false,
+    }
+}
+
+/// Two Spaces; the first has `tabs` conversations, the second one.
+fn fixture(tabs: usize) -> ClientShellSnapshot {
+    let mut snapshot = snapshot();
+    snapshot.focused_workspace_id = Some("ws_1".into());
+    snapshot.focused_tab_id = Some("tab_1_1".into());
+    snapshot.focused_pane_id = Some("pane_1_1".into());
+    snapshot.workspaces = vec![workspace(1, "beacon", true), workspace(2, "website", false)];
+    snapshot.tabs = (1..=tabs).map(|index| tab(1, index, index == 1)).collect();
+    snapshot.tabs.push(tab(2, 1, false));
+    snapshot.panes = (1..=tabs).map(|index| pane(1, index, index == 1)).collect();
+    snapshot.panes.push(pane(2, 1, false));
+    snapshot.agents = (1..=tabs)
+        .map(|index| agent(1, index, &format!("task {index}"), index == 1))
+        .collect();
+    snapshot.agents.push(agent(2, 1, "site task", false));
+    snapshot
+}

+/// Reserved workspace metadata token: any source may set it non-empty via
+/// `workspace.report_metadata` to hide that Space from the sidebar list.
+/// Every consumer of the list (rendering, mouse cards, scroll metrics, and
+/// visible-order navigation) flows through `workspace_list_entries_inner`,
+/// so hidden Spaces drop out of all of them at once.
+pub(crate) const SIDEBAR_HIDDEN_TOKEN: &str = "sidebar_hidden";
+
+fn workspace_sidebar_hidden(app: &AppState, ws_idx: usize) -> bool {
+    // The active workspace — and, while navigating, the selected one — always
+    // stays visible so focus and selection can never point at a hidden row.
+    if app.active == Some(ws_idx) || (matches!(app.mode, Mode::Navigate) && app.selected == ws_idx)
+    {
+        return false;
+    }
+    app.workspaces
+        .get(ws_idx)
+        .and_then(|ws| ws.metadata_tokens.get(SIDEBAR_HIDDEN_TOKEN))
+        .is_some_and(|value| !value.is_empty())
+}

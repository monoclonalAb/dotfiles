+fn indexed_color_to_rgb(index: u8) -> Rgb {
+    const ANSI: [Rgb; 16] = [
+        (0, 0, 0),
+        (128, 0, 0),
+        (0, 128, 0),
+        (128, 128, 0),
+        (0, 0, 128),
+        (128, 0, 128),
+        (0, 128, 128),
+        (192, 192, 192),
+        (128, 128, 128),
+        (255, 0, 0),
+        (0, 255, 0),
+        (255, 255, 0),
+        (0, 0, 255),
+        (255, 0, 255),
+        (0, 255, 255),
+        (255, 255, 255),
+    ];
+    match index {
+        0..=15 => ANSI[index as usize],
+        16..=231 => {
+            const LEVELS: [u8; 6] = [0, 95, 135, 175, 215, 255];
+            let offset = index - 16;
+            (
+                LEVELS[(offset / 36) as usize],
+                LEVELS[((offset % 36) / 6) as usize],
+                LEVELS[(offset % 6) as usize],
+            )
+        }
+        232..=255 => {
+            let level = 8 + (index - 232) * 10;
+            (level, level, level)
+        }
+    }
+}
+
+fn terminal_color_to_rgb(color: Color, app: &AppState) -> Option<Rgb> {
+    let palette_index = match color {
+        Color::Black => Some(0),
+        Color::Red => Some(1),
+        Color::Green => Some(2),
+        Color::Yellow => Some(3),
+        Color::Blue => Some(4),
+        Color::Magenta => Some(5),
+        Color::Cyan => Some(6),
+        Color::Gray => Some(7),
+        Color::DarkGray => Some(8),
+        Color::LightRed => Some(9),
+        Color::LightGreen => Some(10),
+        Color::LightYellow => Some(11),
+        Color::LightBlue => Some(12),
+        Color::LightMagenta => Some(13),
+        Color::LightCyan => Some(14),
+        Color::White => Some(15),
+        Color::Indexed(index) => Some(index),
+        Color::Rgb(r, g, b) => return Some((r, g, b)),
+        Color::Reset => return None,
+    };
+    let index = palette_index?;
+    app.host_terminal_theme.palette[index as usize]
+        .map(|color| (color.r, color.g, color.b))
+        .or_else(|| Some(indexed_color_to_rgb(index)))
+}
+
+fn blend_toward(source: Rgb, target: Rgb, opacity: f32) -> Rgb {
+    let blend = |source: u8, target: u8| {
+        (f32::from(source) * opacity + f32::from(target) * (1.0 - opacity)).round() as u8
+    };
+    (
+        blend(source.0, target.0),
+        blend(source.1, target.1),
+        blend(source.2, target.2),
+    )
+}

#!/bin/sh
# rho-may-merge: say whether /rho may merge its own PR in the current Git
# repository. Allowed: repositories whose main checkout is under
# ~/Desktop/projects/personal/ and whose GitHub owner is the owner below. Other
# people's and organisations' repositories in that folder are excluded. Works
# from a linked worktree too. Prints "yes: ..." and exits 0, or prints
# "no: ..." and exits 1. Reads only local Git metadata.
set -eu

allowed_root=$HOME/Desktop/projects/personal
allowed_owner=monoclonalAb

if ! common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    echo "no: not inside a Git repository"
    exit 1
fi
repository=$(dirname "$common_dir")

case $repository/ in
    "$allowed_root"/*) ;;
    *) echo "no: $repository is not under $allowed_root"; exit 1 ;;
esac

url=$(git remote get-url origin 2>/dev/null || true)
slug=$(printf '%s\n' "$url" | sed -n -E 's#^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+/[^/]+)$#\2#p')
slug=${slug%.git}
owner=${slug%%/*}

if [ -z "$slug" ]; then
    echo "no: origin is not a GitHub repository (${url:-no origin})"
    exit 1
fi
if [ "$owner" != "$allowed_owner" ]; then
    echo "no: $slug belongs to $owner, not $allowed_owner"
    exit 1
fi

echo "yes: $slug is a personal repository"

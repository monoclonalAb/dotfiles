#!/usr/bin/python3
"""artifact: keep the HTML pages agents make in one folder, with an index.

Each artifact is a folder in the store (~/Desktop/artifacts, or $ARTIFACTS_DIR):

    <store>/2026-11-10-pr-284-audit/index.html      the page, plus any assets
    <store>/2026-11-10-pr-284-audit/artifact.json   title, summary, tags, project,
                                                    session, dates
    <store>/index.html                              generated gallery of them all

The artifact.json files are the index. `list` reads them every time, so it
never goes stale; the gallery is rewritten after every change. Pages and their
folders stay outside every repository. Nothing here deletes or moves files:
`add` copies, and an artifact is removed by deleting its folder by hand.
"""

import argparse
import datetime
import html
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import quote

META = "artifact.json"
ENTRY = "index.html"
GALLERY = "index.html"
DEFAULT_LIMIT = 20
USAGE_EXAMPLES = """examples:
  artifact list pr audit                    find earlier pages (all words must match)
  artifact new pr-284-audit --title "PR 284 audit" --summary "Each changed file in
      PR 284 checked against the spec, with open questions" --tags audit,pr
                                            make a folder; prints it, write index.html there
  artifact new pr-301-audit --from pr-284-audit --title ... --summary ...
                                            start from a copy of an earlier page
  artifact update pr-284-audit              after changing the page
  artifact open pr-284                      open in the browser (any unique part of an id)
  artifact open                             open the gallery
"""


class Failure(Exception):
    pass


def store_root():
    configured = os.environ.get("ARTIFACTS_DIR")
    return Path(configured).expanduser() if configured else Path.home() / "Desktop" / "artifacts"


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def slugify(text):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:60].strip("-") or "artifact"


def parse_tags(text):
    tags = []
    for tag in (text or "").split(","):
        tag = tag.strip().lower()
        if tag and tag not in tags:
            tags.append(tag)
    return tags


def detect_project(cwd):
    """The main checkout of the Git repository at cwd (worktrees included), else cwd."""
    try:
        common = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=cwd, capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return str(Path(cwd).resolve())
    common = Path(common)
    return str(common.parent if common.name == ".git" else common)


def write_atomic(path, text):
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def write_meta(folder, meta):
    stored = {key: value for key, value in meta.items() if key not in ("id", "path")}
    write_atomic(folder / META, json.dumps(stored, indent=2, ensure_ascii=False) + "\n")


def ensure_root():
    root = store_root()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    return root


def make_folder(root, slug, date):
    base = f"{date}-{slug}"
    candidate, number = base, 2
    while True:
        try:
            (root / candidate).mkdir(mode=0o700)
            return root / candidate
        except FileExistsError:
            candidate, number = f"{base}-{number}", number + 1


def load_all(root):
    items = []
    if not root.is_dir():
        return items
    for folder in root.iterdir():
        meta_path = folder / META
        if not folder.is_dir() or not meta_path.is_file():
            continue
        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
            if not isinstance(meta, dict):
                raise ValueError("not a JSON object")
        except (OSError, ValueError) as error:
            print(f"artifact: skipping {meta_path}: {error}", file=sys.stderr)
            continue
        meta["id"] = folder.name
        meta["path"] = str(folder)
        items.append(meta)
    items.sort(key=lambda m: (str(m.get("updated", "")), m["id"]), reverse=True)
    return items


def entry_path(meta):
    return Path(meta["path"]) / meta.get("entry", ENTRY)


def find(items, wanted):
    for meta in items:
        if meta["id"] == wanted:
            return meta
    matches = [meta for meta in items if wanted.lower() in meta["id"].lower()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise Failure(f"no artifact matches {wanted!r}; see `artifact list`")
    names = ", ".join(meta["id"] for meta in matches[:10])
    raise Failure(f"{wanted!r} matches {len(matches)} artifacts: {names}")


def searchable(meta):
    parts = [meta["id"], meta.get("title", ""), meta.get("summary", ""),
             " ".join(meta.get("tags", [])), Path(meta.get("project", "")).name]
    return " ".join(str(part) for part in parts).lower()


def html_title(path):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")[:200_000]
    except OSError:
        return None
    match = re.search(r"<title[^>]*>(.*?)</title>", text, re.IGNORECASE | re.DOTALL)
    if not match:
        return None
    title = " ".join(html.unescape(match.group(1)).split())
    return title or None


def write_gallery(root, items):
    """Rewrite <store>/index.html: one self-contained page listing every artifact."""
    cards = []
    for meta in items:
        href = quote(f"{meta['id']}/{meta.get('entry', ENTRY)}")
        tags = "".join(f'<span class="tag">{html.escape(tag)}</span>' for tag in meta.get("tags", []))
        project = Path(meta.get("project", "")).name
        missing = "" if entry_path(meta).is_file() else ' <span class="missing">no page yet</span>'
        cards.append(
            f'<li data-search="{html.escape(searchable(meta))}">'
            f'<a href="{html.escape(href)}">{html.escape(meta.get("title") or meta["id"])}</a>{missing}'
            f'<p>{html.escape(meta.get("summary", ""))}</p>'
            f'<div class="meta"><time>{html.escape(str(meta.get("updated", ""))[:10])}</time>'
            f'{" · " + html.escape(project) if project else ""} · <code>{html.escape(meta["id"])}</code> {tags}</div>'
            "</li>")
    body = "\n".join(cards) or '<li class="empty">No artifacts yet.</li>'
    page = f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Artifacts ({len(items)})</title>
<style>
:root {{ color-scheme: light dark; --muted: #6c6f85; --line: #ccd0da; --accent: #1e66f5; }}
@media (prefers-color-scheme: dark) {{ :root {{ --muted: #a6adc8; --line: #45475a; --accent: #89b4fa; }} }}
body {{ font: 15px/1.5 -apple-system, system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }}
h1 {{ font-size: 1.4rem; }}
input {{ width: 100%; font: inherit; padding: .5rem .7rem; border: 1px solid var(--line); border-radius: 6px; box-sizing: border-box; }}
ul {{ list-style: none; padding: 0; }}
li {{ border-bottom: 1px solid var(--line); padding: .8rem 0; }}
li a {{ font-weight: 600; color: var(--accent); text-decoration: none; }}
li p {{ margin: .2rem 0; }}
.meta {{ color: var(--muted); font-size: .85rem; }}
.tag {{ border: 1px solid var(--line); border-radius: 4px; padding: 0 .35rem; margin-left: .3rem; }}
.missing {{ color: #d20f39; font-size: .85rem; }}
</style>
</head>
<body>
<h1>Artifacts</h1>
<input id="q" type="search" placeholder="Filter by words in the title, summary, tags or project" autofocus>
<ul>
{body}
</ul>
<script>
const q = document.getElementById("q");
q.addEventListener("input", () => {{
  const words = q.value.toLowerCase().split(/\\s+/).filter(Boolean);
  for (const li of document.querySelectorAll("li[data-search]"))
    li.hidden = !words.every(word => li.dataset.search.includes(word));
}});
</script>
</body>
</html>
"""
    write_atomic(root / GALLERY, page)
    return root / GALLERY


def refresh(root):
    return write_gallery(root, load_all(root))


def new_meta(title, summary, tags, project, created):
    meta = {"title": title, "summary": summary, "tags": tags, "project": project,
            "created": created, "updated": now(), "entry": ENTRY}
    session = os.environ.get("PI_SESSION_FILE")
    if session:
        meta["session"] = session
    return meta


def command_new(args):
    root = ensure_root()
    source = find(load_all(root), args.source) if args.source else None
    folder = make_folder(root, slugify(args.slug), datetime.date.today().isoformat())
    meta = new_meta(args.title, args.summary, parse_tags(args.tags),
                    args.project or detect_project(os.getcwd()), now())
    if source:
        shutil.copytree(source["path"], folder, dirs_exist_ok=True,
                        ignore=shutil.ignore_patterns(META))
        meta["entry"] = source.get("entry", ENTRY)
        meta["from"] = source["id"]
    write_meta(folder, meta)
    refresh(root)
    print(folder)
    print(f"artifact: write the page to {folder / meta['entry']}", file=sys.stderr)


def command_add(args):
    source = Path(args.source).expanduser().resolve()
    if source.is_dir():
        store = store_root().resolve()
        if (source / ".git").exists() or source == store or source in store.parents or store in source.parents:
            raise Failure(f"{source} is a repository, the store or inside it; add the page's own folder")
        pages = sorted(path.name for path in source.glob("*.htm*") if path.is_file())
        if not pages:
            raise Failure(f"{source} has no .html file at its top level")
        entry = ENTRY if ENTRY in pages else pages[0]
        entry_source = source / entry
    elif source.is_file():
        entry, entry_source = source.name, source
    else:
        raise Failure(f"{source} does not exist")
    title = args.title or html_title(entry_source) or entry_source.stem
    created = datetime.datetime.fromtimestamp(entry_source.stat().st_mtime).astimezone()
    root = ensure_root()
    folder = make_folder(root, slugify(args.slug or title), created.date().isoformat())
    if source.is_dir():
        shutil.copytree(source, folder, dirs_exist_ok=True)
    else:
        shutil.copy2(source, folder / entry)
    meta = new_meta(title, args.summary, parse_tags(args.tags),
                    args.project or detect_project(os.getcwd()),
                    created.isoformat(timespec="seconds"))
    meta["entry"] = entry
    meta["imported_from"] = str(source)
    write_meta(folder, meta)
    refresh(root)
    print(folder)


def command_list(args):
    items = load_all(store_root())
    words = [word.lower() for word in args.words]
    wanted_tags = [tag.lower() for tag in args.tag]
    here = detect_project(os.getcwd()) if args.here else None
    items = [meta for meta in items
             if all(word in searchable(meta) for word in words)
             and all(tag in meta.get("tags", []) for tag in wanted_tags)
             and (here is None or meta.get("project") == here)]
    hidden = 0
    if args.limit and len(items) > args.limit:
        hidden, items = len(items) - args.limit, items[:args.limit]
    if args.json:
        for meta in items:
            meta["entry_path"] = str(entry_path(meta))
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return
    if not items:
        print("no artifacts" + (" match" if words or wanted_tags or here else f" in {store_root()}"))
        return
    for meta in items:
        tags = f"  [{', '.join(meta.get('tags', []))}]" if meta.get("tags") else ""
        print(f"{meta['id']}  {meta.get('title', '')}{tags}")
        if meta.get("summary"):
            print(f"    {meta['summary']}")
        page = entry_path(meta)
        project = Path(meta.get("project", "")).name
        details = [str(page) if page.is_file() else f"{page} (no page yet)",
                   f"updated {str(meta.get('updated', ''))[:10]}"]
        if project:
            details.append(f"project {project}")
        print("    " + " · ".join(details))
    if hidden:
        print(f"... {hidden} more; add words, --tag or --limit 0")


def command_show(args):
    meta = find(load_all(store_root()), args.id)
    folder = Path(meta["path"])
    meta["entry_path"] = str(entry_path(meta))
    files = sorted(str(path.relative_to(folder)) for path in folder.rglob("*")
                   if path.is_file() and path.name != META)
    meta["files"] = files[:100] + ([f"... {len(files) - 100} more"] if len(files) > 100 else [])
    print(json.dumps(meta, indent=2, ensure_ascii=False))


def command_update(args):
    root = store_root()
    meta = find(load_all(root), args.id)
    if args.title:
        meta["title"] = args.title
    if args.summary:
        meta["summary"] = args.summary
    if args.tags is not None:
        meta["tags"] = parse_tags(args.tags)
    meta["updated"] = now()
    write_meta(Path(meta["path"]), meta)
    refresh(root)
    print(meta["path"])


def command_open(args):
    root = ensure_root()
    if args.id:
        target = entry_path(find(load_all(root), args.id))
        if not target.is_file():
            raise Failure(f"{target} does not exist yet")
    else:
        target = refresh(root)
    subprocess.run(["open", str(target)], check=True)
    print(target)


def command_path(args):
    print(find(load_all(store_root()), args.id)["path"] if args.id else store_root())


def command_index(args):
    print(refresh(ensure_root()))


def parser():
    top = argparse.ArgumentParser(
        prog="artifact", description=__doc__.split("\n\n")[0],
        epilog=USAGE_EXAMPLES, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = top.add_subparsers(dest="command", required=True, metavar="command")

    def describe(command):
        command.add_argument("--title", required=True, help="short name shown in lists")
        command.add_argument("--summary", required=True,
                             help="one or two sentences: what the page shows and what it is for")
        command.add_argument("--tags", default="", help="comma-separated, for example audit,pr")
        command.add_argument("--project", help="project folder (default: the current Git repository)")

    new = sub.add_parser("new", help="make a folder for a new page and print it")
    new.add_argument("slug", help="short name for the folder, for example pr-284-audit")
    new.add_argument("--from", dest="source", metavar="ID", help="start from a copy of this artifact")
    describe(new)
    new.set_defaults(run=command_new)

    add = sub.add_parser("add", help="copy an existing .html file or folder into the store")
    add.add_argument("source")
    add.add_argument("--slug", help="folder name (default: from the title)")
    add.add_argument("--title", help="default: the page's <title>, else the file name")
    add.add_argument("--summary", required=True,
                     help="one or two sentences: what the page shows and what it is for")
    add.add_argument("--tags", default="", help="comma-separated")
    add.add_argument("--project", help="project folder (default: the current Git repository)")
    add.set_defaults(run=command_add)

    listing = sub.add_parser("list", help="newest first; words filter (all must match)")
    listing.add_argument("words", nargs="*")
    listing.add_argument("--tag", action="append", default=[], help="only this tag (repeatable)")
    listing.add_argument("--here", action="store_true", help="only the current Git repository's")
    listing.add_argument("--json", action="store_true")
    listing.add_argument("-n", "--limit", type=int, default=DEFAULT_LIMIT, help="0 for all")
    listing.set_defaults(run=command_list)

    show = sub.add_parser("show", help="an artifact's details and files, as JSON")
    show.add_argument("id", help="its id, or any unique part of it")
    show.set_defaults(run=command_show)

    update = sub.add_parser("update", help="mark a page as changed; optionally edit its details")
    update.add_argument("id")
    update.add_argument("--title")
    update.add_argument("--summary")
    update.add_argument("--tags", help="replaces the tags")
    update.set_defaults(run=command_update)

    opener = sub.add_parser("open", help="open a page, or the gallery, in the browser")
    opener.add_argument("id", nargs="?")
    opener.set_defaults(run=command_open)

    path = sub.add_parser("path", help="print the store folder, or an artifact's folder")
    path.add_argument("id", nargs="?")
    path.set_defaults(run=command_path)

    index = sub.add_parser("index", help="rewrite the gallery page and print its path")
    index.set_defaults(run=command_index)
    return top


def main():
    os.umask(0o077)
    args = parser().parse_args()
    try:
        args.run(args)
    except Failure as error:
        print(f"artifact: {error}", file=sys.stderr)
        return 1
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"artifact: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

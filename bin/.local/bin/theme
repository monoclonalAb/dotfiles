#!/usr/bin/env bash
# theme — cycle the Catppuccin flavour and the background opacity across
# Alacritty, tmux and Neovim at once (bound to Ctrl+Shift+T / Ctrl+Shift+B in
# alacritty.toml).
#
# Why a script instead of per-app config: the flavour used to be hardcoded in
# three unrelated places (alacritty's `import`, tmux's @catppuccin_flavor, nvim's
# colorscheme call), so changing theme meant editing three files and restarting
# things. This owns the choice in one place and pushes it out to each app through
# a mechanism that app already supports.
#
# State (deliberately OUTSIDE the dotfiles repo, so pressing the hotkey never
# dirties `git status` — the repo keeps latte/0.6 as its committed default):
#
#   ~/.local/state/theme/flavour        latte | frappe | macchiato | mocha
#   ~/.local/state/theme/opacity        1.0 | 0.85 | 0.6
#   ~/.local/state/theme/alacritty.toml generated overlay, imported by alacritty.toml
#   ~/.local/state/theme/tmux.conf      generated, sourced by tmux.conf
#
# The path is hardcoded rather than honouring $XDG_STATE_HOME because Alacritty's
# TOML `import` cannot expand environment variables — all four consumers have to
# agree on one literal path.
#
# Written for bash 3.2 (the macOS system bash), same as cycle-2x2.sh.
set -euo pipefail

# Alacritty's hotkey spawns us via `/bin/sh -c`, which sources no profile, so we
# inherit launchd's minimal PATH — /usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin.
# Homebrew is not on it, so `command -v nvim` and `command -v tmux` both failed
# and their push steps were skipped in silence, while the Alacritty overlay (only
# printf/cat/mv/touch, all present) still updated — the hotkey recoloured the
# terminal and nothing else. Prepend the usual prefixes so the script behaves the
# same from the hotkey as from an interactive shell. Absent dirs are ignored.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

FLAVOURS=(latte frappe macchiato mocha)
OPACITIES=(1.0 0.85 0.6)

DEFAULT_FLAVOUR=latte
DEFAULT_OPACITY=0.6

STATE_DIR="$HOME/.local/state/theme"
ALACRITTY_DIR="$HOME/.config/alacritty"
TMUX_CONF="$HOME/.config/tmux/tmux.conf"

usage() {
  cat <<'EOF'
Usage: theme <command>

Commands:
  cycle              next flavour: latte -> frappe -> macchiato -> mocha -> latte
  opacity            next opacity: 1.0 -> 0.85 -> 0.6 -> 1.0
  set <flavour> [opacity]
                     set explicitly, e.g. `theme set mocha 0.85`
                     (also the bootstrap step on a fresh machine)
  status             print the current flavour and opacity, and whether each
                     app is reachable right now
  apply              regenerate the overlays and push to running apps
  -h, --help         show this help

Applies to Alacritty (live config reload), tmux (source-file) and every running
Neovim (RPC). New windows pick up the current theme on startup.

The pushes are best-effort and never block, so cycle/opacity/set/apply also
print what they reached to stderr — discarded under the hotkey, visible when run
by hand. `theme status` probes the same three without changing anything.
EOF
}

die() { printf 'theme: %s\n' "$1" >&2; exit 1; }

# in_list <needle> <haystack...>
in_list() {
  local needle=$1 x
  shift
  for x in "$@"; do
    if [ "$x" = "$needle" ]; then return 0; fi
  done
  return 1
}

# next_in <current> <list...> — element after <current>, wrapping; first if absent
next_in() {
  local cur=$1
  shift
  local n=$# i j
  for ((i = 1; i <= n; i++)); do
    if [ "${!i}" = "$cur" ]; then
      j=$((i % n + 1))
      printf '%s\n' "${!j}"
      return 0
    fi
  done
  printf '%s\n' "$1"
}

# Populates $FLAVOUR / $OPACITY, falling back to the defaults when the state dir
# is missing (fresh machine) or holds something unrecognised (hand-edited).
read_state() {
  FLAVOUR=$(cat "$STATE_DIR/flavour" 2>/dev/null || true)
  OPACITY=$(cat "$STATE_DIR/opacity" 2>/dev/null || true)
  if ! in_list "$FLAVOUR" "${FLAVOURS[@]}"; then FLAVOUR=$DEFAULT_FLAVOUR; fi
  if ! in_list "$OPACITY" "${OPACITIES[@]}"; then OPACITY=$DEFAULT_OPACITY; fi
}

# --- reachability reporting --------------------------------------------------
# Every push below is deliberately best-effort so a dead tmux server or an editor
# sitting in a modal prompt can never hang the hotkey. That silence is also what
# hid the PATH bug fixed above: a target skipped entirely looked exactly like one
# that succeeded. These record what actually happened, so it can be printed.
R_ALACRITTY=
R_TMUX=
R_NVIM=

report() {
  printf 'alacritty  %s\ntmux       %s\nneovim     %s\n' \
    "${R_ALACRITTY:-unknown}" "${R_TMUX:-unknown}" "${R_NVIM:-unknown}"
}

# nvim_summary <verb> <live> <stale>
nvim_summary() {
  local verb=$1 live=$2 stale=$3 msg
  if [ "$live" -eq 0 ]; then
    msg='no running instances'
  else
    msg="$verb $live instance(s)"
  fi
  if [ "$stale" -gt 0 ]; then
    msg="$msg, $stale stale socket(s) skipped"
  fi
  printf '%s\n' "$msg"
}

# scan_nvim_sockets <push|count> — populate NVIM_LIVE / NVIM_STALE; with `push`,
# also fire the reload at each live instance.
NVIM_LIVE=0
NVIM_STALE=0
scan_nvim_sockets() {
  local mode=$1 sock pid
  NVIM_LIVE=0
  NVIM_STALE=0
  for sock in "${TMPDIR:-/tmp}"/nvim."$USER"/*/nvim.*.0 \
    /tmp/nvim."$USER"/*/nvim.*.0; do
    [ -S "$sock" ] || continue
    # Neovim leaves its socket file behind when it exits, so -S alone still
    # matches editors that died weeks ago — and the hotkey would then spawn a
    # doomed client per corpse. The pid is right there in the socket name.
    pid=${sock##*/nvim.}
    pid=${pid%.0}
    if ! kill -0 "$pid" 2>/dev/null; then
      NVIM_STALE=$((NVIM_STALE + 1))
      continue
    fi
    NVIM_LIVE=$((NVIM_LIVE + 1))
    if [ "$mode" = push ]; then
      (nvim --server "$sock" --remote-expr "v:lua.require'theme'.reload()" \
        >/dev/null 2>&1 || true) &
    fi
  done
}

# What `status` shows: the same three lines as apply(), but probing rather than
# pushing, so `theme status` answers "why didn't X change?" without changing it.
probe() {
  if [ -r "$STATE_DIR/alacritty.toml" ]; then
    R_ALACRITTY='overlay present'
  else
    R_ALACRITTY='no overlay yet (run `theme set`)'
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    R_TMUX='UNREACHABLE (tmux not on PATH)'
  elif ! tmux has-session >/dev/null 2>&1; then
    R_TMUX='no server running'
  else
    R_TMUX='server up'
  fi

  if ! command -v nvim >/dev/null 2>&1; then
    R_NVIM='UNREACHABLE (nvim not on PATH)'
  else
    scan_nvim_sockets count
    R_NVIM=$(nvim_summary found "$NVIM_LIVE" "$NVIM_STALE")
  fi
}

# Regenerate both overlays and push the change to whatever is running right now.
# Every step is best-effort: with no tmux server and no Neovim open this still
# exits 0 after updating Alacritty.
apply() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$FLAVOUR" >"$STATE_DIR/flavour"
  printf '%s\n' "$OPACITY" >"$STATE_DIR/opacity"

  # --- Alacritty -----------------------------------------------------------
  # The overlay is the vendored flavour file plus a [window] block. Appending a
  # [window] header after the flavour file's trailing [[colors.indexed_colors]]
  # tables is valid TOML. Write-then-rename so the live_config_reload watcher
  # can never observe a half-written file.
  local src="$ALACRITTY_DIR/themes/catppuccin/catppuccin-$FLAVOUR.toml"
  local variant=Dark
  if [ "$FLAVOUR" = latte ]; then variant=Light; fi
  if [ -r "$src" ]; then
    {
      printf '# Generated by `theme` — do not edit. Run `theme status` to inspect.\n'
      cat "$src"
      printf '\n[window]\nopacity = %s\ndecorations_theme_variant = "%s"\n' \
        "$OPACITY" "$variant"
    } >"$STATE_DIR/alacritty.toml.tmp"
    mv -f "$STATE_DIR/alacritty.toml.tmp" "$STATE_DIR/alacritty.toml"

    # Alacritty does watch imported files, but the rename above swaps the inode.
    # Touching the top-level config guarantees the reload fires; the content is
    # unchanged, so the tracked file stays clean in git.
    if [ -e "$ALACRITTY_DIR/alacritty.toml" ]; then
      touch "$ALACRITTY_DIR/alacritty.toml"
    fi
    R_ALACRITTY='overlay written'
  else
    R_ALACRITTY="SKIPPED (no theme file at $src)"
  fi

  # --- tmux ----------------------------------------------------------------
  {
    printf '# Generated by `theme` — do not edit.\n'
    printf "set -g @catppuccin_flavor '%s'\n" "$FLAVOUR"
  } >"$STATE_DIR/tmux.conf.tmp"
  mv -f "$STATE_DIR/tmux.conf.tmp" "$STATE_DIR/tmux.conf"

  # Re-sourcing tmux.conf is what `prefix + R` already does, and it is
  # idempotent: the @ct_status_installed / @ct_keys_installed guards in that file
  # stop conducterm from re-appending to status-right or rebinding M-a / M-n.
  # It re-runs tpm, which re-runs catppuccin.tmux, which re-reads the flavour.
  if ! command -v tmux >/dev/null 2>&1; then
    R_TMUX='SKIPPED (tmux not on PATH)'
  elif ! tmux has-session >/dev/null 2>&1; then
    R_TMUX='no server running'
  else
    # ...but catppuccin's palette files assign with `set -ogq @thm_*`, and that
    # -o means "leave it alone if already set" (so users can override individual
    # colours). On a plain reload the OLD flavour's palette therefore survives and
    # only @catppuccin_flavor changes — the status bar keeps its previous colours.
    # Clearing the palette first is what makes the new flavour actually take.
    tmux show-options -g 2>/dev/null |
      sed -n 's/^\(@thm_[A-Za-z0-9_]*\).*/\1/p' |
      while IFS= read -r opt; do
        tmux set-option -gu "$opt" >/dev/null 2>&1 || true
      done
    tmux source-file "$TMUX_CONF" >/dev/null 2>&1 || true
    R_TMUX='reloaded'
  fi

  # --- Neovim --------------------------------------------------------------
  # Every running instance listens on its default socket. Each call is
  # backgrounded and swallows its errors, so an editor busy in a modal prompt can
  # never hang the hotkey.
  if ! command -v nvim >/dev/null 2>&1; then
    R_NVIM='SKIPPED (nvim not on PATH)'
  else
    scan_nvim_sockets push
    R_NVIM=$(nvim_summary 'pushed to' "$NVIM_LIVE" "$NVIM_STALE")
  fi

  return 0
}

main() {
  local cmd=${1:-}
  case "$cmd" in
  cycle)
    read_state
    FLAVOUR=$(next_in "$FLAVOUR" "${FLAVOURS[@]}")
    apply
    printf '%s %s\n' "$FLAVOUR" "$OPACITY"
    # stdout stays the bare `<flavour> <opacity>` line; the reachability block
    # goes to stderr, so it is invisible under the hotkey (Alacritty discards it)
    # but shows up the moment you run `theme cycle` by hand.
    report >&2
    ;;
  opacity)
    read_state
    OPACITY=$(next_in "$OPACITY" "${OPACITIES[@]}")
    apply
    printf '%s %s\n' "$FLAVOUR" "$OPACITY"
    report >&2
    ;;
  set)
    [ $# -ge 2 ] || die "set needs a flavour: ${FLAVOURS[*]}"
    read_state
    in_list "$2" "${FLAVOURS[@]}" || die "unknown flavour '$2' (want: ${FLAVOURS[*]})"
    FLAVOUR=$2
    if [ $# -ge 3 ]; then
      in_list "$3" "${OPACITIES[@]}" || die "unknown opacity '$3' (want: ${OPACITIES[*]})"
      OPACITY=$3
    fi
    apply
    printf '%s %s\n' "$FLAVOUR" "$OPACITY"
    report >&2
    ;;
  status)
    read_state
    printf 'flavour  %s\nopacity  %s\nstate    %s\n\n' \
      "$FLAVOUR" "$OPACITY" "$STATE_DIR"
    probe
    report
    ;;
  apply)
    read_state
    apply
    report >&2
    ;;
  -h | --help | help)
    usage
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    die "unknown command '$cmd' (try --help)"
    ;;
  esac
}

main "$@"

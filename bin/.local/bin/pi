#!/bin/sh
# Keep automatic skill discovery disabled; the /skill extension selectively
# contributes only the skills enabled for the current session. Fullscreen mode
# gives the Vim navigation extension an application-owned transcript to scroll.
set -eu

# Reject --skill only where Pi would parse it as an option: before a literal
# "--". Anything after "--" is message text and passes through untouched.
seen_separator=false
tui_mode_set=false
for argument do
    if [ "$seen_separator" = false ]; then
        case "$argument" in
            --)
                seen_separator=true
                ;;
            --skill|--skill=*)
                printf '%s\n' 'pi: use /skill inside Pi to enable skills selectively' >&2
                exit 2
                ;;
            --tui-mode|--tui-mode=*)
                tui_mode_set=true
                ;;
        esac
    fi
done

# Management commands do not start an agent session, and they reject regular
# session flags. Let them pass through unchanged.
apply_session_defaults=true
case "${1-}" in
    auth|config|install|remove|list|update) apply_session_defaults=false ;;
esac

# Insert session defaults where they remain options: before a literal "--"
# separator when one is present, otherwise after all arguments. An explicit
# --tui-mode always wins.
if [ "$apply_session_defaults" = true ]; then
    if [ "$seen_separator" = true ]; then
        remaining=$#
        placed=false
        while [ "$remaining" -gt 0 ]; do
            argument=$1
            shift
            if [ "$placed" = false ] && [ "$argument" = '--' ]; then
                set -- "$@" --no-skills
                if [ "$tui_mode_set" = false ]; then
                    set -- "$@" --tui-mode fullscreen
                fi
                set -- "$@" "$argument"
                placed=true
            else
                set -- "$@" "$argument"
            fi
            remaining=$((remaining - 1))
        done
    else
        set -- "$@" --no-skills
        if [ "$tui_mode_set" = false ]; then
            set -- "$@" --tui-mode fullscreen
        fi
    fi
fi

# Find the next Pi executable in PATH, skipping this wrapper (including symlinks
# to it), so this continues to work when nvm changes the active Node version.
old_ifs=$IFS
IFS=:
for directory in $PATH; do
    IFS=$old_ifs
    [ -n "$directory" ] || directory=.
    candidate=$directory/pi
    if [ -x "$candidate" ] && ! [ "$candidate" -ef "$0" ]; then
        exec "$candidate" "$@"
    fi
    IFS=:
done
IFS=$old_ifs

printf '%s\n' 'pi: could not find the underlying Pi executable in PATH' >&2
exit 127

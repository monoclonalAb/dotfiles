{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "review-bar",
      "type": "block",
      "content": {
        "mod": "review-page",
        "props": {
          "part": "bar"
        }
      },
      "size": {
        "px": 48
      },
      "window_drag": true
    },
    {
      "id": "review-body",
      "type": "row",
      "children": [
        {
          "id": "review-nav",
          "type": "block",
          "content": {
            "mod": "review-nav"
          },
          "size": {
            "px": 340
          },
          "min": 260,
          "max": 600
        },
        {
          "id": "review-page",
          "type": "block",
          "content": {
            "mod": "review-page"
          },
          "background": "background",
          "radius": 14
        },
        {
          "id": "review-side",
          "type": "block",
          "content": {
            "mod": "review-side"
          },
          "size": {
            "px": 400
          },
          "min": 300,
          "max": 700,
          "background": "background",
          "radius": 12
        }
      ],
      "padding": 8,
      "gap": 8
    }
  ],
  "background": "canvas",
  "window_blur": true,
  "font": "Maple Mono NF",
  "ui_font": "SF Pro Rounded",
  "titlebar": "none",
  "traffic_lights": [
    12,
    6
  ],
  "toast": "toast-filter"
}

{
  "mcpServers": {
    "gcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp@0.5.3",
        "-c",
        "/Users/eric/dotfiles/omp/gcloud-mcp-allowlist.json"
      ],
      "env": {
        "PATH": "${HOME}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH}",
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1"
      }
    },
    "gcp-observability": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/observability-mcp@0.2.3"
      ],
      "env": {
        "PATH": "${HOME}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH}",
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1"
      }
    },
    "paper": {
      "url": "http://127.0.0.1:29979/mcp"
    },
    "workspace-context": {
      "command": "/Users/eric/.local/bin/workspace-context-mcp",
      "args": [
        "serve"
      ]
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "beacon": {
      "url": "http://127.0.0.1:47321/mcp",
      "headers": {
        "Authorization": "!echo Bearer $(cat ~/.config/launchpad/secrets/mcp.secret)"
      },
      "description": "Read and change Beacon (the owner's productivity app on this Mac): tasks, habits, events, Calendar.app, books, finances, Screen Time and notes. Call beacon_get_context first."
    },
    "hark": {
      "command": "~/.local/bin/hark-mcp",
      "exposure": "codemode",
      "description": "Hark personal assistant (unofficial API): read/send conversations, wait for replies, answer asks"
    }
  }
}

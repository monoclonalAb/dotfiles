{
  "mcpServers": {
    "gcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp@0.5.3",
        "-c",
        "/Users/eric/dotfiles/omp/.omp/agent/gcloud-mcp-allowlist.json"
      ],
      "env": {
        "PATH": "${HOME}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH}",
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1"
      },
      "lifecycle": "lazy"
    },
    "gcp-observability": {
      "command": "npx",
      "args": ["-y", "@google-cloud/observability-mcp@0.2.3"],
      "env": {
        "PATH": "${HOME}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH}",
        "CLOUDSDK_CORE_DISABLE_PROMPTS": "1"
      },
      "lifecycle": "lazy"
    },
    "paper": {
      "url": "http://127.0.0.1:29979/mcp",
      "lifecycle": "lazy"
    },
    "workspace-context": {
      "command": "/Users/eric/.local/bin/workspace-context-mcp",
      "args": ["serve"],
      "lifecycle": "lazy"
    }
  }
}

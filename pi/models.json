{
  "providers": {
    "lithosai": {
      "baseUrl": "https://api.lithosai.cloud/v1",
      "api": "openai-completions",
      "apiKey": "!security find-generic-password -ws 'lithosai'",
      "models": [
        {
          "id": "deepseek-ai/DeepSeek-V4.1-Flash",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "input": [
            "text",
            "image"
          ],
          "inputLimits": {
            "images": {
              "resize": {
                "maxWidth": 1568,
                "maxHeight": 1568,
                "maxBytes": 1048576,
                "jpegQuality": 80
              }
            }
          },
          "contextWindow": 1000000,
          "maxTokens": 32768,
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cacheRead": 0.003,
            "cacheWrite": 0
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          },
          "compat": {
            "supportsReasoningEffort": true,
            "maxTokensField": "max_tokens"
          }
        }
      ]
    },
    "anthropic": {
      "modelOverrides": {
        "claude-fable-5-1": {
          "compat": {
            "supportsMidConvoEffort": false
          }
        }
      }
    }
  }
}

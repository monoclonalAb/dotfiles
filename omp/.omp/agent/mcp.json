{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "disabledServers": ["node_repl"],
  "mcpServers": {
    "deepwiki": { "type": "http", "url": "https://mcp.deepwiki.com/mcp", "enabled": false },
    "context7": { "type": "http", "url": "https://mcp.context7.com/mcp", "enabled": false },
    "grep": { "type": "http", "url": "https://mcp.grep.app", "enabled": false },
    "semgrep": { "command": "/Users/eric/.local/bin/semgrep", "args": ["mcp"], "enabled": false },
    "github-mcp": { "type": "http", "url": "https://api.githubcopilot.com/mcp/", "enabled": false },
    "octocode": { "command": "npx", "args": ["octocode-mcp@latest"], "enabled": false },
    "gitmcp": { "type": "http", "url": "https://gitmcp.io/docs", "enabled": false },
    "ref-tools": { "type": "http", "url": "https://api.ref.tools/mcp?apiKey=${REF_API_KEY}", "enabled": false },
    "aws-knowledge": { "type": "http", "url": "https://knowledge-mcp.global.api.aws", "enabled": false },
    "aws-docs": { "command": "uvx", "args": ["awslabs.aws-documentation-mcp-server@latest"], "env": { "AWS_DOCUMENTATION_PARTITION": "aws" }, "enabled": false },
    "microsoft-learn": { "type": "http", "url": "https://learn.microsoft.com/api/mcp", "enabled": false },
    "cloudflare-docs": { "type": "http", "url": "https://docs.mcp.cloudflare.com/mcp", "enabled": false },
    "terraform": { "command": "npx", "args": ["-y", "terraform-mcp-server"], "enabled": false },
    "playwright": { "command": "npx", "args": ["@playwright/mcp@latest"], "enabled": false },
    "chrome-devtools": { "command": "npx", "args": ["-y", "chrome-devtools-mcp@latest"], "enabled": false },
    "serena": { "command": "uvx", "args": ["--from", "git+https://github.com/oraios/serena.git", "serena", "start-mcp-server"], "enabled": false },
    "repomix": { "command": "npx", "args": ["-y", "repomix", "--mcp"], "enabled": false },
    "socket": { "type": "http", "url": "https://mcp.socket.dev/", "enabled": false },
    "snyk": { "command": "snyk", "args": ["mcp", "-t", "stdio"], "enabled": false },
    "pal": { "command": "uvx", "args": ["--from", "git+https://github.com/BeehiveInnovations/pal-mcp-server.git", "pal-mcp-server"], "enabled": false },
    "exa": { "type": "http", "url": "https://mcp.exa.ai/mcp", "enabled": false },
    "tavily": { "type": "http", "url": "https://mcp.tavily.com/mcp/", "headers": { "Authorization": "Bearer ${TAVILY_API_KEY}" }, "enabled": false },
    "firecrawl": { "command": "npx", "args": ["-y", "firecrawl-mcp"], "env": { "FIRECRAWL_API_KEY": "FIRECRAWL_API_KEY" }, "enabled": false },
    "jina": { "command": "npx", "args": ["-y", "jina-mcp-tools"], "env": { "JINA_API_KEY": "JINA_API_KEY" }, "enabled": false },
    "basic-memory": { "command": "uvx", "args": ["basic-memory"], "enabled": false },
    "qdrant": { "command": "uvx", "args": ["mcp-server-qdrant"], "env": { "QDRANT_URL": "http://localhost:6333", "COLLECTION_NAME": "agent-memory" }, "enabled": false },
    "obsidian": { "command": "uvx", "args": ["mcp-obsidian"], "env": { "OBSIDIAN_API_KEY": "OBSIDIAN_API_KEY", "OBSIDIAN_HOST": "https://127.0.0.1:27124" }, "enabled": false },
    "postgres": { "command": "uvx", "args": ["postgres-mcp", "--access-mode=restricted"], "env": { "DATABASE_URI": "DATABASE_URI" }, "enabled": false },
    "supabase": { "type": "http", "url": "https://mcp.supabase.com/mcp?read_only=true", "enabled": false },
    "sentry": { "type": "http", "url": "https://mcp.sentry.dev/mcp", "enabled": false },
    "grafana": { "type": "http", "url": "https://YOUR-GRAFANA-HOST/api/mcp", "enabled": false },
    "datadog": { "type": "http", "url": "https://mcp.datadoghq.com/mcp", "enabled": false },
    "linear": { "type": "http", "url": "https://mcp.linear.app/mcp", "enabled": false },
    "atlassian": { "type": "http", "url": "https://mcp.atlassian.com/v1/mcp/authv2", "enabled": false },
    "notion": { "type": "http", "url": "https://mcp.notion.com/mcp", "enabled": false },
    "vercel": { "type": "http", "url": "https://mcp.vercel.com", "enabled": false },
    "netlify": { "command": "npx", "args": ["-y", "@netlify/mcp"], "enabled": false },
    "railway": { "command": "railway", "args": ["mcp"], "enabled": false },
    "flyio": { "command": "flyctl", "args": ["mcp", "serve"], "enabled": false },
    "cloudflare-bindings": { "type": "http", "url": "https://bindings.mcp.cloudflare.com/mcp", "enabled": false },
    "gcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp@0.5.3",
        "-c",
        "/Users/eric/dotfiles/omp/.omp/agent/gcloud-mcp-allowlist.json"
      ],
      "enabled": true
    },
    "gcp-observability": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/observability-mcp@0.2.3"
      ],
      "enabled": true
    },
    "kubernetes": { "command": "docker", "args": ["run", "-i", "--rm", "-v", "${HOME}/.kube:/root/.kube:ro", "quay.io/containers/kubernetes-mcp-server:latest"], "enabled": false },
    "stripe": { "type": "http", "url": "https://mcp.stripe.com", "enabled": false },
    "figma": { "type": "http", "url": "http://127.0.0.1:3845/mcp", "enabled": false },
    "jupyter": { "command": "uvx", "args": ["jupyter-mcp-server"], "enabled": false },
    "langfuse": { "command": "uvx", "args": ["langfuse-mcp", "--public-key", "${LANGFUSE_PUBLIC_KEY}", "--secret-key", "${LANGFUSE_SECRET_KEY}", "--host", "https://cloud.langfuse.com"], "enabled": false }
  }
}

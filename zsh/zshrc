# _zsh_init_cache <name> <key> <command…>: set $REPLY to the command's output,
# reusing ~/.cache/zsh/<name>.zsh until <key> changes. For tool init scripts
# that take milliseconds to generate but only change when the tool does.
# Delete ~/.cache/zsh/ to force a refresh.
_zsh_init_cache() {
  local file=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$1.zsh key="# $2" line=
  shift 2
  [[ -r $file ]] && IFS= read -r line < $file
  if [[ $line == "$key" ]]; then
    REPLY=$(<$file)
  else
    REPLY=$("$@") || return
    { mkdir -p ${file:h} && print -r -- "$key"$'\n'"$REPLY" >| $file.$$ &&
      command mv -f $file.$$ $file } 2>/dev/null
  fi
}

# Route Python commands through the version selected by pyenv.
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
  # `pyenv init` takes ~20 ms and the `pyenv rehash` it runs ~40 ms. Cache the
  # init script per pyenv install, PYENV_ROOT and set of pyenv-sh-* commands
  # (plugins add these to its shell function), and rehash in the background.
  () {
    local libexec=${commands[pyenv]:A:h}
    local -a sh_cmds=($^path/pyenv-sh-*(N:t) $libexec/pyenv-sh-*(N:t)
      $PYENV_ROOT/plugins/*/bin/pyenv-sh-*(N:t) ${libexec:h}/plugins/*/bin/pyenv-sh-*(N:t))
    _zsh_init_cache pyenv-init "$libexec $PYENV_ROOT ${(ou)sh_cmds}" pyenv init - --no-rehash zsh
  } && eval "$REPLY"
  ( command pyenv rehash >/dev/null 2>&1 & )
fi


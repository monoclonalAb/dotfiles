#######
# nvm #
#######

# Sourcing nvm.sh costs 250-400 ms per shell, nearly all of it the automatic
# `nvm use` at its end. Instead, put the Node that `nvm use` would choose on
# PATH here, and load nvm itself the first time `nvm` (or its completion) runs.
# Any case this shortcut does not recognise sources nvm.sh as before.
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm() { unfunction nvm nvm_ls; . "$NVM_DIR/nvm.sh" --no-use && nvm "$@" }
  nvm_ls() { unfunction nvm nvm_ls; . "$NVM_DIR/nvm.sh" --no-use && nvm_ls "$@" }

  # nvm_change_path for the entries nvm writes itself: <array> <suffix> <dir>.
  # Replace the first nvm entry in place, or prepend when there is none or a
  # system bin dir comes before one. Result in $reply; fails on other nvm paths.
  _nvm_fast_change_path() {
    local -a list=("${(@P)1}")
    local -i i sys=0 first=0 last=0
    for (( i = 1; i <= $#list; i++ )); do
      if [[ $list[i] == $NVM_DIR/versions/node/v<->.<->.<->$2 ]]; then
        (( first )) || first=i
        last=i
      elif [[ $list[i] == *$NVM_DIR/* ]]; then
        return 1
      elif (( ! sys )) && [[ $list[i] == (/usr/local|/usr|)$2 ]]; then
        sys=i
      fi
    done
    if (( ! first || (sys && sys < last) )); then
      reply=("$3$2" "${list[@]}")
    else
      list[first]=$3$2
      reply=("${list[@]}")
    fi
  }

  # What nvm.sh's automatic `nvm use` does: keep an nvm Node already first on
  # PATH (a nested shell), otherwise use the `default` alias, followed through
  # $NVM_DIR/alias (default -> lts/* -> lts/krypton -> v24.19.0).
  _nvm_fast_use() {
    emulate -L zsh
    [[ $NVM_SYMLINK_CURRENT != true ]] || return 1
    local node=${commands[node]} version=default dir
    local -i hops=0
    local -a new_path
    if [[ $node == $NVM_DIR/versions/node/v<->.<->.<->/bin/node ]]; then
      dir=${node:h:h}
    elif [[ $node == *$NVM_DIR/* ]]; then
      return 1
    else
      while [[ -f $NVM_DIR/alias/$version ]]; do
        (( ++hops <= 10 )) && [[ -r $NVM_DIR/alias/$version ]] || return 1
        IFS= read -r version < $NVM_DIR/alias/$version
        [[ -n $version && $version != *[^[:lower:][:digit:]./*_-]* && $version != lts/-* ]] || return 1
      done
      [[ $version == v<->.<->.<-> ]] || return 1
      dir=$NVM_DIR/versions/node/$version
    fi
    [[ -x $dir/bin/node ]] || return 1
    _nvm_fast_change_path path /bin $dir || return 1
    new_path=("${reply[@]}")
    if (( $+commands[manpath] )) && [[ -n $MANPATH ]]; then
      _nvm_fast_change_path manpath /share/man $dir || return 1
      manpath=("${reply[@]}")
      export MANPATH
    fi
    path=("${new_path[@]}")
    export NVM_BIN=$dir/bin NVM_INC=$dir/include/node
  }

  _nvm_fast_use || \. "$NVM_DIR/nvm.sh"
  unfunction _nvm_fast_use _nvm_fast_change_path
fi
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

########
# yazi #
########

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

######
# tw #
######

# tw <branch> [prompt…]: make a worktree with Worktrunk (worktrunk/config.toml)
# and open it as its own Tern session, with omp started in that session's shell.
# Run it inside a repository. See docs/HERDR.md#worktrees-in-tern.
function tw() {
	emulate -L zsh
	if (( $# < 1 )); then
		print -u2 'usage: tw <branch> [prompt…]'
		return 2
	fi
	local branch=$1 result dir repo opened block
	shift
	local prompt="$*"
	result=$(wt switch --create "$branch" --no-cd --format=json) || return
	dir=$(jq -r '.path' <<<"$result") || return
	repo=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir) || return
	if ! opened=$(tern new session "${repo:h:t}/$branch" --cwd "$dir" --json); then
		print -u2 "tw: worktree is ready at $dir, but Tern did not open a session"
		return 1
	fi
	block=$(jq -r '.block' <<<"$opened") || return
	tern wait "$block" --until prompt --timeout 30 >/dev/null ||
		print -u2 'tw: no shell prompt seen yet; typing omp anyway'
	tern run "$block" "omp${prompt:+ ${(qq)prompt}}" && tern focus "$block"
}


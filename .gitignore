# macOS
**/.DS_Store

# nvim (managed plugin lockfile / scratch)
**/lazy-lock.json
**/temp.tmp

# zsh runtime + secrets — now nested under zsh/.config/zsh/, so use ** globs
**/.zsh_history
**/.zsh_sessions/
**/.zcompdump*
**/access_tokens.md

# tmux plugins — installed by tpm, not hand-edited.
# Restore on a new machine: git clone https://github.com/tmux-plugins/tpm
#   ~/.config/tmux/plugins/tpm  then start tmux and press <prefix> + I
tmux/.config/tmux/plugins/
